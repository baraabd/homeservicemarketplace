{
  "name": "homeservicemarketplace",
  "private": true,
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:fix": "turbo run lint -- --fix",
    "prepare": "husky",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:up:app": "docker compose -f infra/docker/docker-compose.yml --profile app up -d",
    "docker:up:mongo": "docker compose -f infra/docker/docker-compose.yml --profile app --profile mongo up -d",
    "docker:migrate": "docker compose -f infra/docker/docker-compose.yml --profile app run --rm api-migrate",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml --profile app --profile mongo down",
    "smoke:compose": "bash scripts/ci/compose-smoke.sh",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "postman:provider": "newman run postman/hsm-provider.postman_collection.json -e postman/local.postman_environment.json --bail --reporters cli,htmlextra --reporter-htmlextra-export postman/reports/provider.html",
    "postman:admin": "newman run postman/hsm-admin.postman_collection.json -e postman/local.postman_environment.json --bail --reporters cli,htmlextra --reporter-htmlextra-export postman/reports/admin.html",
    "postman:provider-runtime": "newman run \"postman/FixNow Provider Runtime.postman_collection.json\" -e postman/local.postman_environment.json --bail --reporters cli,htmlextra --reporter-htmlextra-export postman/reports/provider-runtime.html",
    "postman:admin-runtime": "newman run \"postman/FixNow Admin Runtime.postman_collection.json\" -e postman/local.postman_environment.json --bail --reporters cli,htmlextra --reporter-htmlextra-export postman/reports/admin-runtime.html",
    "postman:runtime-smoke": "newman run \"postman/FixNow Runtime Smoke Provider Admin.postman_collection.json\" -e postman/local.postman_environment.json --bail --reporters cli,htmlextra --reporter-htmlextra-export postman/reports/runtime-smoke.html",
    "runtime:provider-loop": "node scripts/runtime/verify-provider-loop.cjs",
    "runtime:verify-500": "node scripts/runtime/verify-runtime-500-elimination.cjs",
    "runtime:sprint01-security": "node scripts/runtime/verify-sprint01-security.cjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "socket.io-client": "^4.7.5",
    "turbo": "2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "^8.21.3",
      "multer@<2.3.0": "^2.3.0",
      "@babel/core@>=7.0.0 <7.29.6": "7.29.6",
      "@humanfs/node@>=0.16.0 <0.16.8": "0.16.8",
      "ajv@>=8.0.0 <8.18.0": "8.18.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
      "brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@>=8.0.0 <8.5.23": "8.5.23",
      "qs@>=6.0.0 <6.16.0": "6.16.0",
      "tar@>=7.0.0 <7.5.21": "7.5.21",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  },
  "volta": {
    "node": "20.18.1",
    "pnpm": "10.32.1"
  }
}
