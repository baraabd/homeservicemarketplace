{
  "name": "homeservicemarketplace",
  "private": true,
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:fix": "turbo run lint -- --fix",
    "prepare": "husky",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:up:app": "docker compose -f infra/docker/docker-compose.yml --profile app up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "postman:provider": "newman run postman/hsm-provider.postman_collection.json -e postman/local.postman_environment.json --bail --reporters cli,htmlextra --reporter-htmlextra-export postman/reports/provider.html",
    "postman:admin": "newman run postman/hsm-admin.postman_collection.json -e postman/local.postman_environment.json --bail --reporters cli,htmlextra --reporter-htmlextra-export postman/reports/admin.html",
    "postman:provider-runtime": "newman run \"postman/FixNow Provider Runtime.postman_collection.json\" -e postman/local.postman_environment.json --bail --reporters cli,htmlextra --reporter-htmlextra-export postman/reports/provider-runtime.html",
    "postman:admin-runtime": "newman run \"postman/FixNow Admin Runtime.postman_collection.json\" -e postman/local.postman_environment.json --bail --reporters cli,htmlextra --reporter-htmlextra-export postman/reports/admin-runtime.html",
    "runtime:provider-loop": "node scripts/runtime/verify-provider-loop.cjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.57.0"
  }
}
