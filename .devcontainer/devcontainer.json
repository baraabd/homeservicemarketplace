{
  "name": "homeservicemarketplace",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [
    4000,
    5173,
    5432,
    6379,
    8025
  ],
  "portsAttributes": {
    "4000": {
      "label": "api"
    },
    "5173": {
      "label": "web"
    },
    "8025": {
      "label": "mailpit"
    }
  },
  "postCreateCommand": "node scripts/runtime/toolchain.cjs && pnpm install --frozen-lockfile",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "prisma.prisma"
      ]
    }
  }
}
