# -----------------------------------------------------------------------------
# Web — Vite public env
# -----------------------------------------------------------------------------
# Every VITE_* variable is inlined into the client bundle at build time.
# Do NOT put secrets here.
#
# VITE_API_URL — absolute URL of the backend API the browser should call.
#
# Local dev:     http://localhost:4000
# Preview:       https://api-preview.<your-domain>   (or the preview API origin)
# Production:    https://api.<your-domain>
#
# For the HttpOnly cookie + CSRF flow to work in preview/prod, the web origin
# and VITE_API_URL must share a registrable domain (e.g. `app.example.com` and
# `api.example.com`). Otherwise browsers will drop the cookies on cross-site
# fetches regardless of `SameSite` — see docs/deployment.md.
VITE_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Google Maps — reverse geocoding (Phase 2 Bug 3)
# -----------------------------------------------------------------------------
# Optional. When set, the "Use my current location" buttons in
# SavedAddressesPage.tsx and JobWizardModal.tsx call the Google Maps
# Geocoding API to translate the captured lat/lng into a human-readable
# street address. When unset (or invalid), the UI falls back gracefully
# to "lat, lng" coordinates in the address field plus a toast asking
# the user to verify before submitting — see apps/web/src/lib/reverse-
# geocode.ts for the typed result envelope.
#
# Restrict the key by HTTP referrer (your web origin) in the Google
# Cloud console — this value is inlined into the client bundle.
VITE_GOOGLE_MAPS_API_KEY=

# Provider Onboarding V2 — the six-task hub at /provider/onboarding.
#
# UNSET MEANS OFF. Every unrecognised value — missing, empty, "false" — reads
# as off and serves the Sprint 8 wizard, so a deploy that says nothing about
# this flag keeps the old surface. That default is why a developer who has
# never set it sees V1 locally while the V2 test suites are green: those
# suites build their own bundle with the flag on, or seed the per-browser
# override, and neither touches your .env.
#
# Precedence: localStorage['hsm.ff.providerOnboardingV2'] wins over this, in
# BOTH directions, so a browser can opt out of a deployment that has it on.
#
# Vite reads .env at STARTUP — restart the dev server after changing it.
VITE_PROVIDER_ONBOARDING_V2=true
