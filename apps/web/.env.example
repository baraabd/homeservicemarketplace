# -----------------------------------------------------------------------------
# Web — Vite public env
# -----------------------------------------------------------------------------
# Every VITE_* variable is inlined into the client bundle at build time.
# Do NOT put secrets here.
#
# VITE_API_URL — absolute URL of the backend API the browser should call.
#
# Local dev:     http://localhost:4000
# Preview:       https://api-preview.<your-domain>   (or the preview API origin)
# Production:    https://api.<your-domain>
#
# For the HttpOnly cookie + CSRF flow to work in preview/prod, the web origin
# and VITE_API_URL must share a registrable domain (e.g. `app.example.com` and
# `api.example.com`). Otherwise browsers will drop the cookies on cross-site
# fetches regardless of `SameSite` — see docs/deployment.md.
VITE_API_URL=http://localhost:4000
