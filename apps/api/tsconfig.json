{
  "compilerOptions": {
    "module": "commonjs",
    // `node10` is the non-deprecated explicit name for the classic Node
    // resolver TS calls `node`. NestJS + CommonJS output require this; the
    // `node16`/`nodenext` strategies would mandate `.js` extensions on every
    // local import, which conflicts with Nest's source layout. No
    // `ignoreDeprecations` needed — this name is current as of TS 5.x.
    "moduleResolution": "node10",
    "target": "ES2022",
    "lib": ["ES2022"],
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    // `jest` enables the global describe/it/expect/jest typings in spec
    // files, so the editor stops flagging them as undefined. The
    // production build (tsconfig.build.json) excludes specs, so this has
    // no effect on emitted output.
    "types": ["node", "jest"]
  },
  // Specs under src/ are picked up by the existing `src/**/*.ts` glob;
  // e2e + integration specs live under `test/` and need their own glob.
  // Excluding them here would hide them from the editor TS server and
  // leave Jest globals (describe/it/expect) undefined in those files.
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
