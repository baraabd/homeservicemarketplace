# R20 real-service fixture. TEST SERVICE ONLY — not a production storage
# recommendation. Mirrors scripts/ci/install-minio-fixture.sh exactly: the
# same upstream security release, built from source with the same declared Go
# toolchain through the public Go module proxy and checksum database.
FROM golang:1.24.8-bookworm AS build
ARG MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
ENV GOFLAGS=-mod=mod GOTOOLCHAIN=local
RUN GOBIN=/out go install "github.com/minio/minio@${MINIO_VERSION}" \
  && GOBIN=/out go install "github.com/minio/mc@v0.0.0-20251106162529-77f82e18b540"

FROM debian:bookworm-slim
RUN useradd --uid 10001 --create-home minio && mkdir -p /data && chown minio /data
COPY --from=build /out/minio /out/mc /usr/local/bin/
USER minio
EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/minio", "server", "/data", "--address", ":9000"]
