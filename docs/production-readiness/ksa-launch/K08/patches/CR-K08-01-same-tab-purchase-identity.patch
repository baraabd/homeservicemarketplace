+/**
+ * Retire one purchase identity after the server confirms that purchase.
+ * Only the exact identity is removed, so a newer purchase is never discarded.
+ * Pending, unknown, timed-out and failed transports must keep their keys.
+ */
+export function retireStripePurchaseKeys(userId: string, planId: string, keys: StripePurchaseKeys) {
+  const storageKey = purchaseStorageKey(userId, planId);
