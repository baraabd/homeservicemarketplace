+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import MockAdapter from 'axios-mock-adapter';
+import type { MoneyPlanVersionWireV1 } from '@homeservicemarketplace/contracts';
+import { api } from '../../../lib/api';
+import { StripePlanPurchase } from './StripePlanPurchase';
+
+// K08 same-tab boundary. The real key module and real tab sessionStorage are
+// used; only HTTP is an explicit Axios double, so this is component evidence,
+// not sandbox or real-API acceptance. Unmount + remount with the same storage
+// models reload and sign-out/sign-in in the same browser tab.
+const plan = { id: 'plan-v1', planKey: 'Synthetic plan', version: 1 } as MoneyPlanVersionWireV1;
+const user = 'synthetic-owner';
+let mock: MockAdapter;
+let attempts = 0;
+let sessionState: 'PROCESSING' | 'CONFIRMED';
+let failNextIntent = false;
+
+const keysFor = (url: string) =>
+  mock.history.post
+    .filter((request) => request.url === url)
+    .map((request) => request.headers?.['Idempotency-Key'] as string);
+
+beforeEach(() => {
+  sessionStorage.clear();
+  attempts = 0;
+  failNextIntent = false;
+  mock = new MockAdapter(api);
+  mock.onPost('/v1/money/intents').reply(() => {
+    if (failNextIntent) {
+      failNextIntent = false;
+      return [503, { code: 'TEMPORARILY_UNAVAILABLE' }];
+    }
+    const id = `intent-${keysFor('/v1/money/intents').length}`;
+    return [200, { id, total: { amountMinor: '100', currency: 'XTS' } }];
+  });
+  mock.onPost(/\/v1\/money\/intents\/[^/]+\/attempts$/u).reply(() => {
+    attempts += 1;
+    return [202, { status: 'ACCEPTED', resourceId: `attempt-${attempts}` }];
+  });
+  mock
+    .onGet(/\/v1\/money\/stripe\/attempts\/[^/]+\/session$/u)
+    .reply(() => [200, { state: sessionState, clientSecret: null, publishableKey: null }]);
+});
+afterEach(() => {
+  cleanup();
+  mock.restore();
+});
+
+async function purchaseOnce() {
+  render(<StripePlanPurchase plan={plan} userId={user} lang="en" />);
+  fireEvent.click(screen.getByRole('button', { name: 'Review sandbox purchase' }));
+  fireEvent.click(await screen.findByRole('button', { name: 'Continue with this amount' }));
+  await screen.findByRole('button', { name: 'Check payment status' });
+  await screen.findAllByRole('status');
+}
+
+describe('K08 same-tab same-plan purchase identity', () => {
+  it('a confirmed purchase does not absorb a second explicit purchase after reload/sign-in', async () => {
+    sessionState = 'CONFIRMED';
+    await purchaseOnce();
+    expect(await screen.findByText(/confirmed by the server/u)).toBeInTheDocument();
+    cleanup(); // reload, sign out, sign in: same tab keeps sessionStorage
+
+    await purchaseOnce();
+    const intentKeys = keysFor('/v1/money/intents');
+    const attemptKeys = mock.history.post
+      .filter((request) => /attempts$/u.test(request.url ?? ''))
+      .map((request) => request.headers?.['Idempotency-Key']);
+    expect(intentKeys).toHaveLength(2);
+    expect(new Set(intentKeys).size).toBe(2);
+    expect(new Set(attemptKeys).size).toBe(2);
+  });
+
+  it('a pending outcome keeps its original identities through reload and repeat submission', async () => {
+    sessionState = 'PROCESSING';
+    await purchaseOnce();
+    cleanup();
+    await purchaseOnce();
+    const intentKeys = keysFor('/v1/money/intents');
+    expect(intentKeys).toHaveLength(2);
+    expect(new Set(intentKeys).size).toBe(1);
+  });
+
+  it('a transport error never rotates the identity', async () => {
+    sessionState = 'PROCESSING';
+    failNextIntent = true;
+    render(<StripePlanPurchase plan={plan} userId={user} lang="en" />);
+    const review = screen.getByRole('button', { name: 'Review sandbox purchase' });
+    fireEvent.click(review);
+    await screen.findByRole('alert');
+    cleanup();
+    render(<StripePlanPurchase plan={plan} userId={user} lang="en" />);
+    fireEvent.click(screen.getByRole('button', { name: 'Review sandbox purchase' }));
+    await screen.findByRole('button', { name: 'Continue with this amount' });
+    const intentKeys = keysFor('/v1/money/intents');
+    expect(intentKeys).toHaveLength(2);
+    expect(new Set(intentKeys).size).toBe(1);
+  });
+});
