# Enable npm-style pre/post script hooks (e.g. `prebuild`, `pretest`).
# pnpm >= 7 defaults this to false, which silently breaks hooks like
# apps/api's `prebuild → pnpm --filter @homeservicemarketplace/database build`
# — the upstream workspace package is never built before the consumer runs.
# Without this flag, `pnpm --filter @homeservicemarketplace/web build` fails
# on Vercel with TS2307 because packages/contracts/dist/ doesn't exist yet.
enable-pre-post-scripts=true
