vitest-report.xml

# npm lockfiles: this is a pnpm workspace; a stray package-lock.json
# silently gives a different tree to anyone who runs npm install.
package-lock.json

# Local restricted-media store (LocalDiskStorageAdapter's root in development).
# Holds real verification EVIDENCE — identity documents, business registrations
# — written by running the app locally. It has never been tracked, and one
# `git add -A` is all it would take. Ignored so that stays true.
#
# Sprint 09B.29: the pattern is deliberately NOT anchored to a directory. The
# adapter's root is `join(process.cwd(), '.restricted-uploads')`, so the store
# lands wherever the API process was started — `apps/api/` under `nest start`,
# but the REPOSITORY ROOT under the isolated Phase 3 stack, which runs
# `node dist-phase3-e2e/main.js` from there. The old `apps/api/`-anchored rule
# left nine real evidence images un-ignored at the root; an unanchored pattern
# matches the store at any depth, so the comment above holds in every launch
# configuration rather than only one.
.restricted-uploads/

# Sprint 09B.29 — the isolated API build the browser E2E runs, kept out of
# apps/api/dist so it cannot race a running `nest start --watch`.
dist-phase2-e2e

# Sprint 09B.29 — the real-API browser bundle. Kept out of apps/web/dist so
# the default Playwright suite (which rebuilds dist with its own VITE_API_URL
# and the V2 flag unset) cannot clobber it, and vice versa.
dist-realapi

# Sprint 09B.29 Phase 3 — the three build outputs the Phase 3 browser gate
# needs, each with its own owner so none can overwrite another:
#   dist-phase3-e2e  the API serving the isolated hsm_phase3_it stack (4012)
#   dist-phase3-v2   the web bundle built with VITE_PROVIDER_ONBOARDING_V2=true
#   dist-phase3-v1   the web bundle built with the same flag explicitly false
# The two web bundles are separate directories on purpose: proving a BUILD-TIME
# flag requires two artifacts, and one preview overwriting the other would make
# the flag-OFF run a test of the flag-ON bundle.
dist-phase3-e2e
dist-phase3-v2
dist-phase3-v1

# Sprint 09B.29 Phase 3 — generated browser EVIDENCE, not source.
#
# `e2e/__artifacts__/` holds the screenshots and axe reports the Phase 3
# journeys write on every run. They are regenerated by the run that proves
# them, so committing them would freeze a copy that no longer corresponds to
# the code and add binary churn to every future run.
#
# NOT ignored, deliberately: `e2e/__screenshots__/`, which holds
# `toMatchSnapshot` BASELINES. Those must be tracked or the visual gate has
# nothing to compare against.
apps/web/e2e/__artifacts__/

# Output of the temporary visual measurement harness
# (`_diagnostic-visual.real-api.spec.ts`), regenerated on demand.
apps/web/visual-diagnostic.json
apps/web/visual-diagnostic.txt
