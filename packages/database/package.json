{
  "name": "@homeservicemarketplace/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prisma",
    "generated"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset --skip-seed",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "lint": "echo \"No lint configured for database package yet\"",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "seed": "dotenv -e ../../.env -- node dist/seed.js",
    "grant:admin": "dotenv -e ../../.env -- node dist/admin-access-grant.js",
    "grant:provider": "dotenv -e ../../.env -- node dist/admin-access-grant.js --provider",
    "verify:migrations": "node scripts/verify-constraint-migrations.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3"
  }
}
