generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                    @id @default(cuid())
  email                     String                    @unique
  passwordHash              String?
  firstName                 String
  lastName                  String
  isActive                  Boolean                   @default(true)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  deletedAt                 DateTime?
  emailVerifiedAt           DateTime?
  failedLoginCount          Int                       @default(0)
  lockedUntil               DateTime?
  mfaEnabled                Boolean                   @default(false)
  mfaEnrolledAt             DateTime?
  mfaSecret                 Bytes?
  passwordUpdatedAt         DateTime?
  status                    AccountStatus             @default(PENDING_VERIFICATION)
  addresses                 Address[]
  auditEvents              AuditEvent[]
  bookingEvents            BookingEvent[]
  bookings                 Booking[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  mfaBackupCodes           MfaBackupCode[]
  notifications            Notification[]
  oauthAccounts            OauthAccount[]
  providerProfile          ProviderProfile?
  serviceRequestEvents     ServiceRequestEvent[]
  serviceRequests          ServiceRequest[]
  sessions                 Session[]
  userProfile              UserProfile?
  userRoles                UserRole[]
  verificationTokens       VerificationToken[]
  disputesOpened           Dispute[]                 @relation("DisputeOpenedBy")
  disputesResolved         Dispute[]                 @relation("DisputeResolvedBy")
  platformSettings         PlatformSetting[]

  @@index([deletedAt])
  @@index([status])
  @@index([lockedUntil])
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([deletedAt])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id         String     @id @default(cuid())
  userId     String
  familyId   String
  parentJti  String?
  currentJti String     @unique
  tokenHash  String     @unique
  ipAddress  String
  userAgent  String
  clientKind ClientKind
  createdAt  DateTime   @default(now())
  lastUsedAt DateTime   @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model VerificationToken {
  id           String       @id @default(cuid())
  userId       String
  tokenHash    String       @unique
  purpose      TokenPurpose
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime     @default(now())
  attemptCount Int          @default(0)
  resendCount  Int          @default(0)
  challengeId  String?      @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
}

model OauthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model AuditEvent {
  id        String         @id @default(cuid())
  userId    String?
  type      AuditEventType
  metadata  Json
  ipAddress String?
  userAgent String?
  requestId String?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Address {
  id               String           @id @default(cuid())
  userId           String
  label            String
  city             String
  country          String
  isDefault        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  type             AddressType
  line1            String
  lat              Float?
  lng              Float?
  deletedAt        DateTime?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests  ServiceRequest[]

  @@index([deletedAt])
  @@index([userId, deletedAt])
  @@index([userId, isDefault])
}

model Bid {
  id                  String          @id @default(cuid())
  requestId           String
  providerId          String
  amount              Int
  currency            String          @default("USD")
  pricingType         PricingType
  note                String?
  status              BidStatus       @default(PENDING)
  responseTimeMinutes Int?
  badge               BidBadge?
  submittedAt         DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  provider            ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  request             ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  booking             Booking?

  @@index([deletedAt])
  @@index([providerId, status])
  @@index([requestId, providerId])
  @@index([requestId, status])
  @@index([submittedAt])
}

model BookingEvent {
  id          String           @id @default(cuid())
  bookingId   String
  actorUserId String?
  type        BookingEventType
  metadata    Json?
  createdAt   DateTime         @default(now())
  actor       User?            @relation(fields: [actorUserId], references: [id])
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([type, createdAt])
}

model Booking {
  id                String          @id @default(cuid())
  requestId         String
  bidId             String          @unique
  seekerUserId      String
  providerId        String
  status            BookingStatus   @default(SCHEDULED)
  scheduledAt       DateTime?
  priceAmount       Int
  currency          String          @default("USD")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  events            BookingEvent[]
  bid               Bid             @relation(fields: [bidId], references: [id], onDelete: Cascade)
  provider          ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  request           ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  seeker            User            @relation(fields: [seekerUserId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  disputes          Dispute[]

  @@index([deletedAt])
  @@index([providerId, status])
  @@index([requestId])
  @@index([seekerUserId, status])
}

model ConversationParticipant {
  id                String                      @id @default(cuid())
  conversationId    String
  userId            String?
  providerProfileId String?
  role              ConversationParticipantRole
  lastReadAt        DateTime?
  createdAt         DateTime                    @default(now())
  conversation      Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  provider          ProviderProfile?            @relation(fields: [providerProfileId], references: [id])
  user              User?                       @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId], map: "conversation_participants_conversation_user_unique")
  @@index([providerProfileId])
  @@index([userId])
}

model Conversation {
  id           String                    @id @default(cuid())
  requestId    String?
  bookingId    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  deletedAt    DateTime?
  participants ConversationParticipant[]
  booking      Booking?                  @relation(fields: [bookingId], references: [id])
  request      ServiceRequest?           @relation(fields: [requestId], references: [id])
  messages     Message[]

  @@index([bookingId])
  @@index([deletedAt])
  @@index([requestId])
  @@index([updatedAt])
}

model Message {
  id             String                      @id @default(cuid())
  conversationId String
  senderUserId   String?
  senderRole     ConversationParticipantRole
  body           String
  createdAt      DateTime                    @default(now())
  deletedAt      DateTime?
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?                       @relation(fields: [senderUserId], references: [id])

  @@index([conversationId, createdAt])
  @@index([deletedAt])
}

model Notification {
  id           String                    @id @default(cuid())
  userId       String
  type         NotificationType
  title        String
  body         String
  resourceType NotificationResourceType?
  resourceId   String?
  deepLink     String?
  metadata     Json?
  readAt       DateTime?
  createdAt    DateTime                  @default(now())
  deletedAt    DateTime?
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([resourceType, resourceId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model ProviderProfile {
  id                        String                            @id @default(cuid())
  userId                    String?                           @unique
  displayName               String
  initials                  String
  avatarUrl                 String?
  ratingAvg                 Float                             @default(0)
  reviewCount               Int                               @default(0)
  completedJobs             Int                               @default(0)
  verified                  Boolean                           @default(false)
  topPro                    Boolean                           @default(false)
  bio                       String?
  headline                  String?
  phoneNumber               String?
  serviceAreaCity           String?
  serviceAreaCountry        String?
  serviceAreaLat            Float?
  serviceAreaLng            Float?
  serviceAreaRadiusKm       Int?
  availability              ProviderAvailability              @default(OFFLINE)
  status                    ProviderProfileStatus             @default(DRAFT)
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  deletedAt                 DateTime?
  bids                      Bid[]
  bookings                  Booking[]
  conversationParticipants  ConversationParticipant[]
  serviceCategories         ProviderProfileServiceCategory[]
  user                      User?                             @relation(fields: [userId], references: [id])

  @@index([availability])
  @@index([deletedAt])
  @@index([serviceAreaCity])
  @@index([status])
}

model ProviderProfileServiceCategory {
  providerProfileId String
  serviceCategoryId String
  createdAt         DateTime        @default(now())
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@id([providerProfileId, serviceCategoryId])
  @@index([serviceCategoryId])
}

model ServiceCategory {
  id                String                           @id @default(cuid())
  slug              String                           @unique
  labelEn           String
  labelAr           String
  icon              String
  sortOrder         Int                              @default(0)
  isActive          Boolean                          @default(true)
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  deletedAt         DateTime?
  serviceRequests   ServiceRequest[]
  providerProfiles  ProviderProfileServiceCategory[]

  @@index([deletedAt])
  @@index([isActive, sortOrder])
}

model ServiceRequestEvent {
  id               String                  @id @default(cuid())
  requestId        String
  actorUserId      String?
  type             ServiceRequestEventType
  metadata         Json?
  createdAt        DateTime                @default(now())
  actor            User?                   @relation(fields: [actorUserId], references: [id])
  request          ServiceRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([type, createdAt])
}

model ServiceRequest {
  id                     String                @id @default(cuid())
  seekerUserId           String
  categoryId             String?
  customServiceText      String?
  description            String?
  status                 ServiceRequestStatus  @default(OPEN_FOR_BIDS)
  scheduleType           ScheduleType
  scheduledAt            DateTime?
  addressId              String?
  addressSnapshot        Json
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?
  bids                   Bid[]
  bookings               Booking[]
  conversations          Conversation[]
  events                 ServiceRequestEvent[]
  address                Address?              @relation(fields: [addressId], references: [id])
  category               ServiceCategory?      @relation(fields: [categoryId], references: [id])
  seeker                 User                  @relation(fields: [seekerUserId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([createdAt])
  @@index([seekerUserId, deletedAt])
  @@index([seekerUserId, status])
  @@index([status])
}

model Dispute {
  id          String         @id @default(cuid())
  bookingId   String
  openedById  String
  status      DisputeStatus  @default(OPEN)
  reason      String
  resolution  String?
  resolvedAt  DateTime?
  resolvedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  openedBy    User           @relation("DisputeOpenedBy", fields: [openedById], references: [id])
  resolvedBy  User?          @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])

  @@index([bookingId])
  @@index([openedById])
  @@index([status, createdAt])
  @@index([deletedAt])
}

model PlatformSetting {
  key        String   @id
  value      Json
  updatedAt  DateTime @updatedAt
  updatedBy  String?
  updatedByUser User?  @relation(fields: [updatedBy], references: [id])

  @@index([updatedBy])
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  avatarUrl   String?
  phoneNumber String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  city        String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DELETED
}

enum ClientKind {
  WEB
  MOBILE
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
  REGISTRATION_OTP
}

enum AuditEventType {
  USER_REGISTERED
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_RESENT
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  REFRESH_ROTATED
  REFRESH_REPLAY
  SESSION_REVOKED
  MFA_ENROLLED
  MFA_DISABLED
  MFA_CHALLENGE_FAILED
  MFA_BACKUP_USED
  OAUTH_LINKED
  ROLE_ASSIGNED
  ROLE_REVOKED
  ADMIN_USER_SUSPENDED
  ADMIN_USER_RESTORED
  ADMIN_PROVIDER_APPROVED
  ADMIN_PROVIDER_REJECTED
  ADMIN_PROVIDER_SUSPENDED
  ADMIN_DISPUTE_OPENED
  ADMIN_DISPUTE_RESOLVED
  ADMIN_SETTING_UPDATED
}

enum AddressType {
  HOME
  WORK
  CUSTOM
}

enum BidBadge {
  BEST_MATCH
  BEST_VALUE
  FASTEST
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingEventType {
  BOOKING_CREATED
  BOOKING_CANCELLED
  BOOKING_STATUS_CHANGED
  BOOKING_RESCHEDULED
}

enum BookingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ConversationParticipantRole {
  SEEKER
  PROVIDER
  SYSTEM
}

enum NotificationResourceType {
  REQUEST
  BID
  BOOKING
  CONVERSATION
  REVIEW
}

enum NotificationType {
  BID_RECEIVED
  BID_ACCEPTED
  BOOKING_CREATED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  MESSAGE_RECEIVED
  REVIEW_REQUESTED
  SYSTEM
}

enum PricingType {
  HOURLY
  FIXED
}

enum ProviderAvailability {
  ONLINE
  OFFLINE
  PAUSED
}

enum ProviderProfileStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED_REFUND
  RESOLVED_PARTIAL
  RESOLVED_DENIED
  CANCELLED
}

enum ScheduleType {
  ASAP
  LATER
}

enum ServiceRequestEventType {
  REQUEST_CREATED
  REQUEST_UPDATED
  REQUEST_CANCELLED
  REQUEST_REOPENED
}

enum ServiceRequestStatus {
  OPEN_FOR_BIDS
  BID_ACCEPTED
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
