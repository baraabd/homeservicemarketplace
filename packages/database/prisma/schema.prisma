generator client {
  provider = "prisma-client-js"
  // D-8 — generate INTO the workspace package instead of the default
  // node_modules/.prisma/client.
  //
  // With pnpm's virtual store the default output lands in
  // node_modules/.pnpm/@prisma+client@<ver>/node_modules/.prisma/client, which
  // `pnpm deploy` does not carry into the production bundle. The image then
  // booted (or failed to boot) depending on whether a copy of that directory
  // had been hand-stitched into the right place — fragile, and it broke as
  // soon as the store layout changed.
  //
  // Generating into packages/database/generated/prisma makes the client part
  // of the package's own files, so `pnpm deploy` copies it like any other
  // source. One location, same in local dev, CI, and the container.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                    @id @default(cuid())
  email                      String                    @unique
  passwordHash               String?
  firstName                  String
  lastName                   String
  isActive                   Boolean                   @default(true)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  deletedAt                  DateTime?
  emailVerifiedAt            DateTime?
  failedLoginCount           Int                       @default(0)
  lockedUntil                DateTime?
  mfaEnabled                 Boolean                   @default(false)
  mfaEnrolledAt              DateTime?
  mfaSecret                  Bytes?
  passwordUpdatedAt          DateTime?
  status                     AccountStatus             @default(PENDING_VERIFICATION)
  addresses                  Address[]
  auditEvents                AuditEvent[]
  bookingEvents              BookingEvent[]
  bookings                   Booking[]
  conversationParticipants   ConversationParticipant[]
  messages                   Message[]
  mfaBackupCodes             MfaBackupCode[]
  notifications              Notification[]
  oauthAccounts              OauthAccount[]
  providerProfile            ProviderProfile?
  serviceRequestEvents       ServiceRequestEvent[]
  serviceRequests            ServiceRequest[]
  sessions                   Session[]
  userProfile                UserProfile?
  userRoles                  UserRole[]
  verificationTokens         VerificationToken[]
  disputesOpened             Dispute[]                 @relation("DisputeOpenedBy")
  disputesResolved           Dispute[]                 @relation("DisputeResolvedBy")
  disputeEvents              DisputeEvent[]            @relation("DisputeEventActor")
  platformSettings           PlatformSetting[]
  adminAccessRequests        AdminAccessRequest[]      @relation("AdminAccessRequestApplicant")
  adminAccessRequestsDecided AdminAccessRequest[]      @relation("AdminAccessRequestReviewer")

  @@index([deletedAt])
  @@index([status])
  @@index([lockedUntil])
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([deletedAt])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id         String     @id @default(cuid())
  userId     String
  familyId   String
  parentJti  String?
  currentJti String     @unique
  tokenHash  String     @unique
  ipAddress  String
  userAgent  String
  clientKind ClientKind
  createdAt  DateTime   @default(now())
  lastUsedAt DateTime   @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

// Phase 4 — the Admin ACCESS-REQUEST axis.
//
// A public signup must never grant the admin role. Signing up through the
// Admin-themed entry point creates an ordinary verified User identity and,
// only when the person explicitly submits one, a PENDING AdminAccessRequest.
// The request is a request: it grants nothing until a DIFFERENT, currently
// authorized administrator approves it.
//
// This is deliberately a THIRD axis, separate from User.status (may this
// identity authenticate?) and UserRole (what may it do?). Conflating them is
// what produced screens calling a user "Admin active" purely because
// User.status === ACTIVE.
//
// One PENDING request per user at a time is enforced in the service layer —
// Prisma has no partial unique index, and a strict unique on userId would
// block a legitimate re-application after a rejection.
model AdminAccessRequest {
  id              String                   @id @default(cuid())
  userId          String
  status          AdminAccessRequestStatus @default(PENDING)
  /// Why the applicant believes they need admin access. Operator-facing only.
  justification   String?                  @db.Text
  /// Admin who approved or rejected. Never the applicant themselves — the
  /// service refuses self-review.
  decidedByUserId String?
  decidedAt       DateTime?
  /// Reviewer's note on the decision. Surfaced to the applicant on rejection.
  decisionNote    String?                  @db.Text
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user      User  @relation("AdminAccessRequestApplicant", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("AdminAccessRequestReviewer", fields: [decidedByUserId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
}

model VerificationToken {
  id           String       @id @default(cuid())
  userId       String
  tokenHash    String       @unique
  purpose      TokenPurpose
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime     @default(now())
  attemptCount Int          @default(0)
  resendCount  Int          @default(0)
  challengeId  String?      @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
}

model OauthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model AuditEvent {
  id        String         @id @default(cuid())
  userId    String?
  type      AuditEventType
  metadata  Json
  ipAddress String?
  userAgent String?
  requestId String?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Address {
  id              String           @id @default(cuid())
  userId          String
  label           String
  city            String
  country         String
  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  type            AddressType
  line1           String
  lat             Float?
  lng             Float?
  deletedAt       DateTime?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]

  @@index([deletedAt])
  @@index([userId, deletedAt])
  @@index([userId, isDefault])
}

model Bid {
  id                  String          @id @default(cuid())
  requestId           String
  providerId          String
  amount              Int
  currency            String          @default("USD")
  pricingType         PricingType
  note                String?
  status              BidStatus       @default(PENDING)
  responseTimeMinutes Int?
  badge               BidBadge?
  submittedAt         DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  provider            ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  request             ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  booking             Booking?

  @@index([deletedAt])
  @@index([providerId, status])
  @@index([requestId, providerId])
  @@index([requestId, status])
  @@index([submittedAt])
}

model BookingEvent {
  id          String           @id @default(cuid())
  bookingId   String
  actorUserId String?
  type        BookingEventType
  metadata    Json?
  createdAt   DateTime         @default(now())
  actor       User?            @relation(fields: [actorUserId], references: [id])
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([type, createdAt])
}

model Booking {
  id            String          @id @default(cuid())
  requestId     String
  bidId         String          @unique
  seekerUserId  String
  providerId    String
  status        BookingStatus   @default(SCHEDULED)
  scheduledAt   DateTime?
  priceAmount   Int
  currency      String          @default("USD")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  events        BookingEvent[]
  bid           Bid             @relation(fields: [bidId], references: [id], onDelete: Cascade)
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  request       ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  seeker        User            @relation(fields: [seekerUserId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  disputes      Dispute[]

  @@index([deletedAt])
  @@index([providerId, status])
  @@index([requestId])
  @@index([seekerUserId, status])
}

model ConversationParticipant {
  id                String                      @id @default(cuid())
  conversationId    String
  userId            String?
  providerProfileId String?
  role              ConversationParticipantRole
  lastReadAt        DateTime?
  createdAt         DateTime                    @default(now())
  conversation      Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  provider          ProviderProfile?            @relation(fields: [providerProfileId], references: [id])
  user              User?                       @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId], map: "conversation_participants_conversation_user_unique")
  @@index([providerProfileId])
  @@index([userId])
}

model Conversation {
  id           String                    @id @default(cuid())
  requestId    String?
  bookingId    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  deletedAt    DateTime?
  participants ConversationParticipant[]
  booking      Booking?                  @relation(fields: [bookingId], references: [id])
  request      ServiceRequest?           @relation(fields: [requestId], references: [id])
  messages     Message[]

  // A live booking has at most one live conversation. Postgres-side this
  // is a partial unique index (`WHERE "bookingId" IS NOT NULL AND
  // "deletedAt" IS NULL`) created in the Sprint 7.3 migration — Prisma's
  // `@@unique` cannot express the `WHERE` clause, so the unique is
  // enforced exclusively by the DB and surfaced through Prisma's
  // P2002 path; the service re-fetches the existing row on conflict.
  @@index([bookingId])
  @@index([deletedAt])
  @@index([requestId])
  @@index([updatedAt])
}

model Message {
  id             String                      @id @default(cuid())
  conversationId String
  senderUserId   String?
  senderRole     ConversationParticipantRole
  body           String
  createdAt      DateTime                    @default(now())
  deletedAt      DateTime?
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?                       @relation(fields: [senderUserId], references: [id])

  @@index([conversationId, createdAt])
  @@index([deletedAt])
}

model Notification {
  id           String                    @id @default(cuid())
  userId       String
  type         NotificationType
  title        String
  body         String
  resourceType NotificationResourceType?
  resourceId   String?
  deepLink     String?
  metadata     Json?
  readAt       DateTime?
  createdAt    DateTime                  @default(now())
  deletedAt    DateTime?
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([resourceType, resourceId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model ProviderProfile {
  id                       String                           @id @default(cuid())
  userId                   String?                          @unique
  displayName              String
  initials                 String
  avatarUrl                String?
  ratingAvg                Float                            @default(0)
  reviewCount              Int                              @default(0)
  completedJobs            Int                              @default(0)
  verified                 Boolean                          @default(false)
  topPro                   Boolean                          @default(false)
  bio                      String?
  headline                 String?
  phoneNumber              String?
  serviceAreaCity          String?
  serviceAreaCountry       String?
  serviceAreaLat           Float?
  serviceAreaLng           Float?
  serviceAreaRadiusKm      Int?
  availability             ProviderAvailability             @default(OFFLINE)
  status                   ProviderProfileStatus            @default(DRAFT)
  // Phase 4 — provider onboarding lifecycle timestamps.
  //
  // `POST /v1/me/provider/upgrade` creates a DRAFT profile; it no longer
  // stamps PENDING_REVIEW, because an upgrade is not an application. The
  // provider completes onboarding in DRAFT and then explicitly submits, which
  // is what sets submittedForReviewAt and moves the row to PENDING_REVIEW.
  submittedForReviewAt     DateTime?
  // When an admin approved / rejected / suspended, and why. rejectionReason is
  // surfaced to the provider so a REJECTED applicant is told what to fix,
  // rather than seeing a generic "account problem" message.
  reviewedAt               DateTime?
  reviewedByUserId         String?
  rejectionReason          String?                          @db.Text
  // Sprint 6.2 — admin-facing review notes. Free-text, persisted
  // separately from the audit history so a reviewer can pin context
  // without scanning every prior decision. Mutated only via
  // PATCH /v1/admin/providers/:id/review-notes (admin role required).
  reviewNotes              String?                          @db.Text
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  deletedAt                DateTime?
  bids                     Bid[]
  bookings                 Booking[]
  conversationParticipants ConversationParticipant[]
  serviceCategories        ProviderProfileServiceCategory[]
  // Pending / historical category applications. Approved rows are mirrored
  // into ProviderProfileServiceCategory by the admin review workflow; this
  // table is the audit trail + the source for the provider profile's
  // pendingCategories surface.
  categoryApplications     ProviderCategoryApplication[]
  user                     User?                            @relation(fields: [userId], references: [id])

  // Sprint 6 — a normalised mirror of serviceAreaCity, written by the same
  // code path that writes the display value. The fan-out query previously
  // compared the DISPLAY-cased serviceAreaCity to an already-normalised
  // cityKey using `mode: 'insensitive'`, which is both unindexable (it
  // becomes a citext-less ILIKE) and subtly wrong the moment normalisation
  // does anything beyond lowercasing.
  serviceAreaCityKey       String?

  // ── Sprint 7: provider lifecycle axes ───────────────────────────────────
  //
  // Six independent axes replace what one `status` column was being asked to
  // mean. See docs/adr/0005-provider-lifecycle-axes.md.
  //
  // ALL NULLABLE, and `status` above stays authoritative for this sprint —
  // docs/adr/0007 owns the compatibility window. These are written by the
  // backfill and by new code, and read by ProviderCapabilityService, but they
  // do not yet gate the marketplace: flipping the gate before Sprint 9 issues
  // work-access grants would deny every provider on the platform.
  //
  // Axis 1 — onboarding. Is the application complete and submitted?
  onboardingState          ProviderOnboardingState?
  // Axis 2 — verification. Have we confirmed WHO they are?
  //
  // Backfilled to UNVERIFIED for every row INCLUDING approved ones: no
  // historical provider ever had a document checked, and recording them as
  // VERIFIED would invent an audit trail.
  verificationState        ProviderVerificationState?
  // Axis 3 — provider standing on the marketplace. Distinct from account
  // standing (User.status), which outranks it — see the precedence table.
  standingState            ProviderStandingState?
  // Axis 5 — what they have paid for. Inert: never grants a capability.
  subscriptionTier         ProviderSubscriptionTier?
  // Where the axis values above came from. LEGACY_APPROVED is deliberately
  // NOT a synonym for verified — it records "approved under the old process,
  // identity never checked", which is what makes those rows findable when
  // verification becomes required.
  lifecycleSource          ProviderLifecycleSource?
  // When the backfill (or new code) last wrote the axes. Null means never.
  lifecycleSyncedAt        DateTime?

  onboardingSubmissions    ProviderOnboardingSubmission[]
  workAccessGrants         ProviderWorkAccessGrant[]

  // ── Sprint 8: onboarding journey fields ─────────────────────────────────
  // docs/adr/0008-category-hierarchy-and-onboarding-draft.md
  //
  // All nullable and all additive: an existing provider row is untouched and
  // still valid, and the completeness policy is what decides whether a given
  // profile may be SUBMITTED — not the column definitions.

  /// Individual vs business. Changes which other fields are required.
  providerType             ProviderType?
  /// Business display name, for BUSINESS providers. Distinct from
  /// displayName, which is the public marketplace name either way.
  legalBusinessName        String?
  /// Proof the phone is reachable. Presence of a number is not proof.
  phoneVerifiedAt          DateTime?
  profileImageUrl          String?
  /// Numeric fact, not a display bucket. A bucket ("5-10 years") cannot be
  /// compared, filtered, or aged; this can, and the UI renders whatever band
  /// it likes from it.
  yearsOfExperience        Int?
  /// Alternative to the count, for providers who know when they started. The
  /// policy accepts EITHER and derives years from this when present, so the
  /// stored fact stays a fact and does not silently go stale.
  professionSince          DateTime?
  transportMode            ProviderTransportMode?
  /// Fixed premises, if any. Distinct from the service-area centre: a
  /// workshop is where they are, the service area is where they go.
  workshopAddressLine      String?
  workshopLat              Float?
  workshopLng              Float?
  additionalInformation    String?                          @db.Text
  /// The consent document version the provider accepted, and when. A boolean
  /// "agreed" is unfalsifiable the moment the terms change.
  acceptedConsentVersion   String?
  consentAcceptedAt        DateTime?

  availabilityIntervals    ProviderAvailabilityInterval[]
  equipment                ProviderEquipment[]
  serviceAreas             ProviderServiceArea[]
  onboardingDraft          ProviderOnboardingDraft?

  @@index([availability])
  @@index([deletedAt])
  @@index([serviceAreaCity])
  @@index([status])
  // Sprint 6 — fan-out recipient selection. Leading equality on the two
  // columns every fan-out carries, then the selective one.
  @@index([status, deletedAt, serviceAreaCityKey])
  @@index([status, deletedAt, serviceAreaLat, serviceAreaLng])
  // Sprint 7 — the reconciliation report scans "rows the backfill has not
  // reached yet", and the admin queue will filter by axis once the axes are
  // authoritative. Leading equality on deletedAt keeps soft-deleted rows out
  // of both without a second pass.
  @@index([deletedAt, onboardingState])
  @@index([deletedAt, standingState])
  @@index([lifecycleSyncedAt])
}

model ProviderProfileServiceCategory {
  providerProfileId String
  serviceCategoryId String
  createdAt         DateTime        @default(now())
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@id([providerProfileId, serviceCategoryId])
  @@index([serviceCategoryId])
}

// Provider applies to add a ServiceCategory to their approved skill set;
// admin approves or rejects. The PENDING row is what the Provider app's
// `pendingCategories` surface reads. APPROVED rows mirror into
// ProviderProfileServiceCategory and serve as the audit trail; REJECTED
// rows stay so the same admin can see prior decisions on the same
// category.
//
// Sprint 2 — the "one PENDING per (provider, category)" rule is now a REAL
// database constraint, not a service-layer convention:
//
//   provider_category_application_one_pending_uniq
//     UNIQUE (providerProfileId, serviceCategoryId)
//     WHERE status = 'PENDING' AND supersededAt IS NULL
//
// It is a partial unique index, so it cannot be expressed in this schema and
// lives in a raw forward-only migration. Prisma's diff engine ignores partial
// indexes entirely, which is what lets the CI drift gate stay green — but it
// also means Prisma will never recreate this index for you. It is created
// once, forward-only, and must never be dropped by a schema edit.
//
// A plain (providerProfileId, serviceCategoryId) unique would have been
// expressible here but is wrong: it would block the legitimate
// apply → rejected → re-apply flow.
model ProviderCategoryApplication {
  id                String                            @id @default(cuid())
  providerProfileId String
  serviceCategoryId String
  status            ProviderCategoryApplicationStatus @default(PENDING)
  // Set when this PENDING row was displaced by an identical earlier
  // application rather than decided by an admin.
  //
  // The distinction matters. Collapsing duplicates by flipping them to
  // REJECTED would fabricate an admin decision that nobody made and would
  // poison the audit trail the REJECTED state exists to carry. A superseded
  // row keeps status=PENDING — which is what it honestly was — and drops out
  // of the partial unique index and out of `pendingCategories` because of
  // this column. Nothing is deleted; the row stays queryable forever.
  supersededAt      DateTime?
  // Which application displaced it, so the chain is walkable in both
  // directions. Deliberately a bare id, not a relation: a self-relation here
  // would add a foreign key whose only purpose is provenance, and the target
  // row must survive independently of it.
  supersededById    String?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, status])
  @@index([serviceCategoryId, status])
  @@index([status, createdAt])
  @@index([supersededAt])
}

model ServiceCategory {
  id                   String                           @id @default(cuid())
  slug                 String                           @unique
  labelEn              String
  labelAr              String
  icon                 String
  sortOrder            Int                              @default(0)
  isActive             Boolean                          @default(true)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  deletedAt            DateTime?

  // ── Sprint 8: parent/child hierarchy ────────────────────────────────────
  // docs/adr/0008-category-hierarchy-and-onboarding-draft.md
  //
  // Self-referencing, one level deep in practice but not constrained to it.
  // Backward compatible by construction: every existing row keeps parentId
  // NULL and isLeaf TRUE, so it stays exactly what it is today — a selectable
  // competency at the root. Nothing that reads ServiceCategory has to change.
  parentId             String?
  parent               ServiceCategory?                 @relation("CategoryTree", fields: [parentId], references: [id])
  children             ServiceCategory[]                @relation("CategoryTree")

  // Is this a SELECTABLE competency, or an organisational heading?
  //
  // Selectability is a property of the catalogue, decided server-side. Letting
  // the client infer it from "has no children" would make the rule a
  // suggestion, and would silently flip a parent into a selectable leaf the
  // moment its last child was deactivated.
  isLeaf               Boolean                          @default(true)

  serviceRequests      ServiceRequest[]
  providerProfiles     ProviderProfileServiceCategory[]
  categoryApplications ProviderCategoryApplication[]
  equipmentItems       EquipmentCatalogItem[]

  @@index([deletedAt])
  @@index([isActive, sortOrder])
  // Rendering a parent's children in catalogue order — the wizard's hot read.
  @@index([parentId, sortOrder])
  // "Every selectable competency", which is what matching and the specialty
  // picker both ask for.
  @@index([isLeaf, isActive])
}

model ServiceRequestEvent {
  id          String                  @id @default(cuid())
  requestId   String
  actorUserId String?
  type        ServiceRequestEventType
  metadata    Json?
  createdAt   DateTime                @default(now())
  actor       User?                   @relation(fields: [actorUserId], references: [id])
  request     ServiceRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([type, createdAt])
}

model ServiceRequest {
  id                String                @id @default(cuid())
  seekerUserId      String
  categoryId        String?
  customServiceText String?
  description       String?
  // Sprint 7.x — seeker-uploaded photos of the issue (e.g. broken pipe,
  // leaky faucet). Stored as a Postgres `text[]` so the JSON wire shape
  // stays a flat string array. Empty by default; existing rows backfill
  // to `'{}'` via the @default clause without data movement. The upload
  // pipeline (presigned URLs) is a later slice — this column is the
  // receiving end of the wire.
  mediaUrls         String[]              @default([])
  status            ServiceRequestStatus  @default(OPEN_FOR_BIDS)
  scheduleType      ScheduleType
  scheduledAt       DateTime?
  addressId         String?
  addressSnapshot   Json
  // Sprint 6 — location PROMOTED out of addressSnapshot into real columns.
  //
  // The snapshot stays the display source of truth (label, line1, country).
  // These three are the QUERYABLE mirror, written in the same statement that
  // writes the snapshot. The provider feed previously filtered on
  // `addressSnapshot->>'cityKey'`, which no index can serve, so every feed
  // page was a sequential scan over the whole table. A JSON path expression
  // also cannot participate in the bounding-box range scan the service-area
  // predicate needs. See docs/adr/0003-service-area-geo-strategy.md.
  locationCityKey   String?
  locationLat       Float?
  locationLng       Float?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  bids              Bid[]
  bookings          Booking[]
  conversations     Conversation[]
  events            ServiceRequestEvent[]
  address           Address?              @relation(fields: [addressId], references: [id])
  category          ServiceCategory?      @relation(fields: [categoryId], references: [id])
  seeker            User                  @relation(fields: [seekerUserId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([createdAt])
  @@index([seekerUserId, deletedAt])
  @@index([seekerUserId, status])
  @@index([status])
  // Sprint 6 — the two access paths of the provider feed.
  //
  // Both lead with the equality columns every feed query carries
  // (status, deletedAt) so the index is usable, then the selective column:
  //   * cityKey  — the fallback path and the city-equality path
  //   * lat/lng  — the bounding-box prefilter; lat is the leading range key
  //                because a radius bound on latitude is a fixed number of
  //                degrees, while the longitude bound widens with latitude.
  @@index([status, deletedAt, locationCityKey])
  @@index([status, deletedAt, locationLat, locationLng])
}

model Dispute {
  id           String          @id @default(cuid())
  bookingId    String
  openedById   String
  status       DisputeStatus   @default(OPEN)
  // Sprint 6.3 — admin triage priority. Defaults to MEDIUM so existing
  // rows backfill cleanly without a separate UPDATE.
  priority     DisputePriority @default(MEDIUM)
  reason       String
  // Sprint 6.3 — long-form description. The original `reason` is the
  // short headline (kept for back-compat with the open-dispute flow);
  // `description` carries the full operator narrative.
  description  String?
  resolution   String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  booking      Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  openedBy     User            @relation("DisputeOpenedBy", fields: [openedById], references: [id])
  resolvedBy   User?           @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  events       DisputeEvent[]

