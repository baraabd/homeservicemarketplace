  @@index([openedById])
  @@index([status, createdAt])
  @@index([priority, status])
  @@index([deletedAt])
}

// Sprint 6.3 — verification timeline for a single dispute. Mirrors
// the AuditEvent shape but is dispute-scoped + carries before/after
// JSON snapshots so the operator can reconstruct each transition.
// Sprint 2 — the receipt a constraint migration leaves behind.
//
// Adding a uniqueness constraint to a table that already has duplicates has
// exactly three possible outcomes: refuse to migrate, mutate rows, or delete
// rows. The third is never acceptable here, and the second is only acceptable
// if it is reversible and visible — which requires writing down what was
// touched BEFORE touching it.
//
// Every automatic remediation performed by a Sprint 2 constraint migration
// writes one row here first, capturing the pre-change values in `before`.
// That makes each remediation individually reversible from data that lives in
// the same database, with no dependency on a backup, and it means "what did
// that migration do to my rows?" is a query rather than an excavation.
//
// Constraints whose conflicts CANNOT be resolved without judgement — merging
// two real user accounts, retracting a live commercial bid — do not write here
// at all. They refuse to migrate and hand the decision to an operator.
model DataRemediationLog {
  id         String   @id @default(cuid())
  // The migration directory name, so a row is traceable to the exact
  // forward-only step that wrote it.
  migration  String
  // The invariant being established, e.g. "one_default_address_per_user".
  constraintName String
  entity     String
  entityId   String
  // What was done: SUPERSEDED, DEMOTED, ... Free-text by design; these rows
  // are read by operators and tests, never branched on by application code.
  action     String
  // The pre-change column values for the affected row. This is the part that
  // makes the change reversible.
  before     Json?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([migration])
  @@index([constraintName])
  @@index([entity, entityId])
}

model DisputeEvent {
  id          String           @id @default(cuid())
  disputeId   String
  actorUserId String?
  type        DisputeEventType
  before      Json?
  after       Json?
  message     String?
  createdAt   DateTime         @default(now())
  dispute     Dispute          @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actor       User?            @relation("DisputeEventActor", fields: [actorUserId], references: [id])

  @@index([disputeId, createdAt])
  @@index([type, createdAt])
}

model PlatformSetting {
  key           String   @id
  value         Json
  updatedAt     DateTime @updatedAt
  updatedBy     String?
  updatedByUser User?    @relation(fields: [updatedBy], references: [id])

  @@index([updatedBy])
}

model UserProfile {
