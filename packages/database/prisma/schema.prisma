// IAM baseline schema.
// Additive to the prior IAM-only migration. Extends User with account-state
// and MFA-readiness fields, adds sessions/tokens/audit/oauth tables. Business
// domain tables (Provider, Booking, Service, etc.) are NOT modeled here —
// they belong to later phase modules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DELETED
}

enum ClientKind {
  WEB
  MOBILE
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  // Short-form numeric OTP challenges (6-digit). The same table backs both
  // link tokens and OTPs — the `tokenHash` column stores sha256(raw) in both
  // cases; only the format of `raw` and how it is presented to the user
  // differ. `challengeId`, `attemptCount`, and `resendCount` are only used
  // by the OTP purposes below.
  REGISTRATION_OTP
  LOGIN_OTP
}

enum AuditEventType {
  USER_REGISTERED
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_RESENT
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  REFRESH_ROTATED
  REFRESH_REPLAY
  SESSION_REVOKED
  MFA_ENROLLED
  MFA_DISABLED
  MFA_CHALLENGE_FAILED
  MFA_BACKUP_USED
  OAUTH_LINKED
  ROLE_ASSIGNED
  ROLE_REVOKED
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  passwordHash      String?
  firstName         String
  lastName          String
  isActive          Boolean       @default(true)
  status            AccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?
  passwordUpdatedAt DateTime?
  failedLoginCount  Int           @default(0)
  lockedUntil       DateTime?
  mfaEnabled        Boolean       @default(false)
  mfaSecret         Bytes?
  mfaEnrolledAt     DateTime?

  userRoles          UserRole[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  oauthAccounts      OauthAccount[]
  mfaBackupCodes     MfaBackupCode[]
  auditEvents        AuditEvent[]
  addresses          Address[]
  profile            UserProfile?
  serviceRequests    ServiceRequest[]      @relation("seekerRequests")
  requestEventsActed ServiceRequestEvent[] @relation("requestEventActor")
  providerProfile    ProviderProfile?
  bookingsAsSeeker   Booking[]             @relation("seekerBookings")
  bookingEventsActed BookingEvent[]        @relation("bookingEventActor")
  conversationsParticipating ConversationParticipant[] @relation("userConversations")
  messagesSent       Message[]             @relation("userMessagesSent")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([status])
  @@index([lockedUntil])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Session row = one login = one device. Refresh tokens rotate within a
// familyId; a rotation issues a new row sharing the familyId and chains
// parentJti to the previous currentJti. Replay of a revoked refresh token
// is detected by tokenHash lookup hitting a row with revokedAt != null,
// which triggers family-wide revoke.
model Session {
  id         String     @id @default(cuid())
  userId     String
  familyId   String
  parentJti  String?
  currentJti String     @unique
  tokenHash  String     @unique
  ipAddress  String
  userAgent  String
  clientKind ClientKind
  createdAt  DateTime   @default(now())
  lastUsedAt DateTime   @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

// Single table for email-verification, password-reset, and email-OTP flows.
// `purpose` discriminates. `tokenHash` is sha256 of the random secret sent
// to the user; plaintext is never stored. For OTP purposes
// (REGISTRATION_OTP / LOGIN_OTP) the raw secret is a 6-digit numeric code;
// `challengeId` is an opaque reference the client presents at verify-otp /
// resend-otp time, and the attempt / resend counters enforce rate limits.
model VerificationToken {
  id           String       @id @default(cuid())
  userId       String
  tokenHash    String       @unique
  purpose      TokenPurpose
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime     @default(now())
  // OTP-only columns — null for EMAIL_VERIFICATION / PASSWORD_RESET rows.
  challengeId  String?      @unique
  attemptCount Int          @default(0)
  resendCount  Int          @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model OauthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_backup_codes")
}

// ─── Seeker domain (Sprint 1) ────────────────────────────────────────────────
// Service-category catalog. Read-only from the API surface; rows are
// curated through migrations / admin tooling, not user input. Bilingual
// labels live on the row so the API can return whichever locale the
// client asked for without a join. `slug` is the stable, machine-readable
// identifier the frontend keys on (e.g. "plumbing", "ac-repair").
//
// Soft-delete supported via `deletedAt` so a category that was previously
// posted against can be hidden from new request creation without breaking
// historical references from service_requests in later sprints.
model ServiceCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  labelEn   String
  labelAr   String
  icon      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  serviceRequests ServiceRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("service_categories")
}

// Saved addresses for an authenticated user (Sprint 1, slice 2).
// Always scoped to a userId on read and write — `userId` is set from the
// authenticated session on the server, never trusted from client input.
//
// `isDefault` carries an at-most-one-true-per-user invariant. Enforced in
// the application layer inside a transaction (see AddressesService.setDefault)
// — promote-then-demote happens atomically so two interleaved writers
// converge on a single default. We deliberately do NOT add a DB-level
// partial unique index here; doing so would require a raw-SQL migration
// step Prisma can't reflect into schema.prisma, which trips drift
// detection on every subsequent `migrate dev`.
//
// `lat`/`lng` are nullable because not every address row will be reverse-
// geocoded at create time (e.g. user types a label-only entry). They are
// populated when the client supplies coordinates from the location picker.
//
// Soft-deleted via `deletedAt`. All read sites filter `deletedAt: null`
// so a deleted row never appears to the client even via stale references.
model Address {
  id        String      @id @default(cuid())
  userId    String
  label     String
  type      AddressType
  line1     String
  city      String
  country   String
  lat       Float?
  lng       Float?
  isDefault Boolean     @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceRequests ServiceRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Ownership lookup (the dominant access pattern: list-my-addresses).
  @@index([userId, deletedAt])
  // Default-address lookup (which row is the user's current default?).
  @@index([userId, isDefault])
  // Generic deleted-row sweep / housekeeping.
  @@index([deletedAt])
  @@map("addresses")
}

enum AddressType {
  HOME
  WORK
  CUSTOM
}

// One-to-one profile sidecar created by an earlier (pre-slice-2)
// migration. Modelled here so the Prisma schema reflects the actual DB
// shape — without this declaration `prisma migrate dev` would detect
// schema drift on every run. The slice-2 work does not read or write
// this table; it exists only to keep the migration history consistent
// with reality.
model UserProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  avatarUrl   String?
  phoneNumber String?
  bio         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

// Service-request lifecycle (Sprint 1, slice 3). One row per Seeker job
// posting. `seekerUserId` is the only ownership signal — it is set from
// the authenticated session at create time, never from the wire.
//
// `categoryId` is nullable so a Seeker can post a free-form request
// against `customServiceText` when none of the curated catalog
// categories fits. Service-layer validation requires at least one of
// the two to be present.
//
// `addressSnapshot` is JSON because we deliberately copy the address
// fields onto the request at create time. This decouples the request
// from later edits / soft-deletes of the source Address row: a Seeker
// renaming "Home" to something else, or deleting it, must NOT mutate
// the historical request the Provider is bidding on. `addressId`
// stays linked for traceability but no read site joins through it.
//
// `status` is the lifecycle discriminator. Slice 3 only implements
// OPEN_FOR_BIDS / CANCELLED; the future statuses (BID_ACCEPTED, BOOKED,
// IN_PROGRESS, COMPLETED) are present in the enum so the values are
// stable from day one and don't require an enum-add migration when
// later slices bring bids/bookings online.
model ServiceRequest {
  id                String                @id @default(cuid())
  seekerUserId      String
  categoryId        String?
  customServiceText String?
  description       String?
  status            ServiceRequestStatus  @default(OPEN_FOR_BIDS)
  scheduleType      ScheduleType
  scheduledAt       DateTime?
  addressId         String?
  // JSON snapshot of the address at creation time. Stored as Json
  // rather than discrete columns so the snapshot shape can evolve
  // without a migration (it always carries label/line1/city/country/
  // lat/lng but the wire shape is the source of truth).
  addressSnapshot   Json
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?

  seeker   User             @relation("seekerRequests", fields: [seekerUserId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  address  Address?         @relation(fields: [addressId], references: [id], onDelete: SetNull)
  events   ServiceRequestEvent[]
  bids     Bid[]
  bookings Booking[]
  conversations Conversation[]

  // Dominant access pattern: list-my-requests filtered by status.
  @@index([seekerUserId, status])
  // Soft-delete-aware ownership lookup.
  @@index([seekerUserId, deletedAt])
  // Category-scoped lookup (future Provider feed).
  @@index([categoryId])
  // Time-ordered listing.
  @@index([createdAt])
  // Cross-user status sweep (admin / future).
  @@index([status])
  @@map("service_requests")
}

enum ServiceRequestStatus {
  OPEN_FOR_BIDS
  BID_ACCEPTED
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ScheduleType {
  ASAP
  LATER
}

// Append-only timeline of state changes against a request. Driven by the
// requests service inside the same transaction as the underlying state
// transition, so the timeline can never disagree with the request row.
//
// `actorUserId` is nullable because future slices will emit events on
// behalf of system actors (auto-cancel after 14d, etc.); for slice 3
// every event is authored by the request owner.
model ServiceRequestEvent {
  id          String                  @id @default(cuid())
  requestId   String
  actorUserId String?
  type        ServiceRequestEventType
  metadata    Json?
  createdAt   DateTime                @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation("requestEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([type, createdAt])
  @@map("service_request_events")
}

enum ServiceRequestEventType {
  REQUEST_CREATED
  REQUEST_UPDATED
  REQUEST_CANCELLED
  REQUEST_REOPENED
}

// Provider read-model for the Seeker Bids screen (Sprint 2, slice 2.1).
// `userId` is nullable because the Provider app is out of scope for
// this slice — most rows in slice 2.1 are seeded test data without a
// linked user. When the Provider app ships and a real provider signs
// up, that user's id is attached here. The relation is nullable on
// both sides so detaching a user does not orphan bids.
//
// Display fields (`displayName`, `initials`, `avatarUrl`) and the
// reputation bag (`ratingAvg`, `reviewCount`, `completedJobs`,
// `verified`, `topPro`) are denormalized onto this row so a single
// query can populate the BidsScreen without joining through reviews
// or completed bookings (those tables don't exist yet anyway).
model ProviderProfile {
  id             String   @id @default(cuid())
  userId         String?  @unique
  displayName    String
  initials       String
  avatarUrl      String?
  ratingAvg      Float    @default(0)
  reviewCount    Int      @default(0)
  completedJobs  Int      @default(0)
  verified       Boolean  @default(false)
  topPro         Boolean  @default(false)

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bids     Bid[]
  bookings Booking[]
  conversationsParticipating ConversationParticipant[] @relation("providerConversations")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("provider_profiles")
}

// One Provider's bid on one Seeker request (Sprint 2, slice 2.1).
//
// At-most-one ACTIVE bid per (request, provider) is enforced in the
// application layer (BidsService.create — implemented in slice 2.2).
// Slice 2.1 only surfaces the read path; an additional partial
// unique index would buy DB-layer safety but Prisma can't reflect a
// partial unique into schema.prisma, so we rely on the (requestId,
// providerId) composite index for fast existence checks instead and
// keep the invariant in the service.
//
// Soft-deleted via `deletedAt` so a withdrawn-then-resubmitted bid
// keeps a stable id and historical reference, while every read site
// filters `deletedAt: null`.
model Bid {
  id                  String      @id @default(cuid())
  requestId           String
  providerId          String
  amount              Int
  currency            String      @default("USD")
  pricingType         PricingType
  note                String?
  status              BidStatus   @default(PENDING)
  responseTimeMinutes Int?
  badge               BidBadge?
  submittedAt         DateTime    @default(now())

  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  booking  Booking?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Dominant access pattern: list-bids-for-request filtered by status.
  @@index([requestId, status])
  // Reverse access pattern (provider's own bids, future Provider app).
  @@index([providerId, status])
  // Existence check for the at-most-one-active-bid-per-(req,provider)
  // invariant the create path enforces.
  @@index([requestId, providerId])
  // Time-ordered listing for "latest bids" sort.
  @@index([submittedAt])
  // Generic deleted-row sweep / housekeeping.
  @@index([deletedAt])
  @@map("bids")
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PricingType {
  HOURLY
  FIXED
}

enum BidBadge {
  BEST_MATCH
  BEST_VALUE
  FASTEST
}

// Booking row created when a Seeker accepts a bid (Sprint 2, slice 2.2).
// One booking per accepted bid; `bidId` is unique so attempting to
// create two bookings against the same bid violates the constraint
// at the DB layer (defence in depth on top of the application-layer
// transaction in BidsService.acceptBid).
//
// `seekerUserId` is denormalized here so booking-listing endpoints
// (future slice) can scope by user without joining through the
// request. `providerId` is denormalized for the same reason on the
// future Provider feed.
//
// `priceAmount` and `currency` are snapshotted from the bid at
// acceptance time so a future Provider edit of the bid (rare; only
// possible when status is PENDING anyway) cannot mutate the booked
// amount. `scheduledAt` is nullable for ASAP bookings.
//
// Soft delete supported via `deletedAt` for cancellation flows in
// future slices; slice 2.2 only writes SCHEDULED rows.
model Booking {
  id           String        @id @default(cuid())
  requestId    String
  bidId        String        @unique
  seekerUserId String
  providerId   String
  status       BookingStatus @default(SCHEDULED)
  scheduledAt  DateTime?
  priceAmount  Int
  currency     String        @default("USD")

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  bid      Bid             @relation(fields: [bidId], references: [id], onDelete: Cascade)
  seeker   User            @relation("seekerBookings", fields: [seekerUserId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  events   BookingEvent[]
  conversations Conversation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Dominant access patterns:
  // - "list-my-bookings" filtered by status (Seeker's bookings tab —
  //   future slice).
  @@index([seekerUserId, status])
  // - "list-provider-bookings" (future Provider app).
  @@index([providerId, status])
  // - reverse-lookup: which booking covers this request?
  @@index([requestId])
  // - housekeeping.
  @@index([deletedAt])
  @@map("bookings")
}

enum BookingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Append-only timeline of state changes against a booking. Slice 2.3
// emits BOOKING_CREATED (from inside the accept-bid transaction) and
// BOOKING_CANCELLED. The remaining lifecycle types are pinned now so
// the next slice (Provider/tracking) doesn't force another enum
// migration.
//
// `actorUserId` is nullable because system actors (auto-cancel, auto-
// complete-after-N-days, etc.) will write events here in later slices.
model BookingEvent {
  id          String           @id @default(cuid())
  bookingId   String
  actorUserId String?
  type        BookingEventType
  metadata    Json?
  createdAt   DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("bookingEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  // Dominant access pattern: timeline render = list-by-booking
  // chronologically. Primary index covers it.
  @@index([bookingId, createdAt])
  // Secondary: housekeeping / cross-booking analytics — not used in
  // slice 2.3 reads but cheap and aligned with ServiceRequestEvent.
  @@index([type, createdAt])
  @@map("booking_events")
}

enum BookingEventType {
  BOOKING_CREATED
  BOOKING_CANCELLED
  BOOKING_STATUS_CHANGED
  BOOKING_RESCHEDULED
}

// Audit rows are append-only. `metadata` is a JSON blob limited to an
// allowlist of fields by the writer (AuditService) — never raw request
// bodies or driver errors.
model AuditEvent {
  id        String         @id @default(cuid())
  userId    String?
  type      AuditEventType
  metadata  Json
  ipAddress String?
  userAgent String?
  requestId String?
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("audit_events")
}

// Chat conversation (Sprint 3, slice 3.3). Backed by Postgres (text-only).
// One conversation MAY be linked to a request (pre-booking inquiry —
// future surface) and/or a booking. Both link fields are nullable
// because future support / system conversations don't have either.
//
// `updatedAt` is touched on every new message so the conversations
// list can render newest-active-first without joining through Message.
model Conversation {
  id        String  @id @default(cuid())
  requestId String?
  bookingId String?

  request  ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  booking  Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Dominant access patterns:
  // - "list-my-conversations" — joined through participants.userId.
  //   The active-newest-first order uses updatedAt; the index above
  //   (per-conversation lookup) is satisfied by the primary key.
  @@index([bookingId])
  @@index([requestId])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("conversations")
}

// One row per (conversation, party). The party is either a real User
// (always the case for the Seeker) OR a ProviderProfile that hasn't
// been linked to a User yet (the Provider app is out of scope; future
// Provider sign-up will fill in `userId`).
//
// At most one of `userId` / `providerProfileId` is set per row; the
// service layer enforces this. `role` distinguishes SEEKER / PROVIDER /
// SYSTEM so the renderer can style sender bubbles correctly.
//
// `lastReadAt` drives the unread badge on the conversations list.
model ConversationParticipant {
  id                String                       @id @default(cuid())
  conversationId    String
  userId            String?
  providerProfileId String?
  role              ConversationParticipantRole
  lastReadAt        DateTime?
  createdAt         DateTime                     @default(now())

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?            @relation("userConversations", fields: [userId], references: [id], onDelete: SetNull)
  provider     ProviderProfile? @relation("providerConversations", fields: [providerProfileId], references: [id], onDelete: SetNull)

  // Dominant access patterns:
  // - "is this user a participant of this conversation?" — primary
  //   ownership gate.
  @@unique([conversationId, userId], name: "conversation_user_unique")
  // - "list conversations for this user" — joined from User to
  //   participant rows.
  @@index([userId])
  // - same for the provider profile slot.
  @@index([providerProfileId])
  @@map("conversation_participants")
}

enum ConversationParticipantRole {
  SEEKER
  PROVIDER
  SYSTEM
}

// Text-only chat message (Sprint 3, slice 3.3). `senderUserId` is
// nullable for SYSTEM messages and for Provider messages before the
// Provider app exists. `senderRole` is denormalised so the renderer
// can style bubbles without joining through ConversationParticipant.
//
// `body` is text-only — attachments are explicitly out of scope.
//
// Soft delete supported for a future "delete message" surface.
model Message {
  id             String                       @id @default(cuid())
  conversationId String
  senderUserId   String?
  senderRole     ConversationParticipantRole
  body           String
  createdAt      DateTime                     @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("userMessagesSent", fields: [senderUserId], references: [id], onDelete: SetNull)

  // Dominant access pattern: chronological message render.
  @@index([conversationId, createdAt])
  // Housekeeping for soft-deleted rows.
  @@index([deletedAt])
  @@map("messages")
}
