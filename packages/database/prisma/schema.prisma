generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                      @id @default(cuid())
  email                     String                      @unique
  passwordHash              String?
  firstName                 String
  lastName                  String
  isActive                  Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  deletedAt                 DateTime?
  emailVerifiedAt           DateTime?
  failedLoginCount          Int                         @default(0)
  lockedUntil               DateTime?
  mfaEnabled                Boolean                     @default(false)
  mfaEnrolledAt             DateTime?
  mfaSecret                 Bytes?
  passwordUpdatedAt         DateTime?
  status                    AccountStatus               @default(PENDING_VERIFICATION)
  addresses                 addresses[]
  auditEvents               AuditEvent[]
  booking_events            booking_events[]
  bookings                  bookings[]
  conversation_participants conversation_participants[]
  messages                  messages[]
  mfaBackupCodes            MfaBackupCode[]
  notifications             notifications[]
  oauthAccounts             OauthAccount[]
  provider_profiles         provider_profiles?
  service_request_events    service_request_events[]
  service_requests          service_requests[]
  sessions                  Session[]
  user_profiles             user_profiles?
  userRoles                 UserRole[]
  verificationTokens        VerificationToken[]

  @@index([deletedAt])
  @@index([status])
  @@index([lockedUntil])
  @@map("users")
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("UserRole")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("RolePermission")
}

model Session {
  id         String     @id @default(cuid())
  userId     String
  familyId   String
  parentJti  String?
  currentJti String     @unique
  tokenHash  String     @unique
  ipAddress  String
  userAgent  String
  clientKind ClientKind
  createdAt  DateTime   @default(now())
  lastUsedAt DateTime   @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id           String       @id @default(cuid())
  userId       String
  tokenHash    String       @unique
  purpose      TokenPurpose
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime     @default(now())
  attemptCount Int          @default(0)
  resendCount  Int          @default(0)
  challengeId  String?      @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
  @@map("VerificationToken")
}

model OauthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("OauthAccount")
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("MfaBackupCode")
}

model AuditEvent {
  id        String         @id @default(cuid())
  userId    String?
  type      AuditEventType
  metadata  Json
  ipAddress String?
  userAgent String?
  requestId String?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("AuditEvent")
}

model addresses {
  id               String             @id
  userId           String
  label            String
  city             String
  country          String
  isDefault        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  type             AddressType
  line1            String
  lat              Float?
  lng              Float?
  deletedAt        DateTime?
  users            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  service_requests service_requests[]

  @@index([deletedAt])
  @@index([userId, deletedAt])
  @@index([userId, isDefault])
}

model bids {
  id                  String            @id
  requestId           String
  providerId          String
  amount              Int
  currency            String            @default("USD")
  pricingType         PricingType
  note                String?
  status              BidStatus         @default(PENDING)
  responseTimeMinutes Int?
  badge               BidBadge?
  submittedAt         DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  deletedAt           DateTime?
  provider_profiles   provider_profiles @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service_requests    service_requests  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  bookings            bookings?

  @@index([deletedAt])
  @@index([providerId, status])
  @@index([requestId, providerId])
  @@index([requestId, status])
  @@index([submittedAt])
}

model booking_events {
  id          String           @id
  bookingId   String
  actorUserId String?
  type        BookingEventType
  metadata    Json?
  createdAt   DateTime         @default(now())
  users       User?            @relation(fields: [actorUserId], references: [id])
  bookings    bookings         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([type, createdAt])
}

model bookings {
  id                String            @id
  requestId         String
  bidId             String            @unique
  seekerUserId      String
  providerId        String
  status            BookingStatus     @default(SCHEDULED)
  scheduledAt       DateTime?
  priceAmount       Int
  currency          String            @default("USD")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  deletedAt         DateTime?
  booking_events    booking_events[]
  bids              bids              @relation(fields: [bidId], references: [id], onDelete: Cascade)
  provider_profiles provider_profiles @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service_requests  service_requests  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  users             User              @relation(fields: [seekerUserId], references: [id], onDelete: Cascade)
  conversations     conversations[]

  @@index([deletedAt])
  @@index([providerId, status])
  @@index([requestId])
  @@index([seekerUserId, status])
}

model conversation_participants {
  id                String                      @id
  conversationId    String
  userId            String?
  providerProfileId String?
  role              ConversationParticipantRole
  lastReadAt        DateTime?
  createdAt         DateTime                    @default(now())
  conversations     conversations               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  provider_profiles provider_profiles?          @relation(fields: [providerProfileId], references: [id])
  users             User?                       @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId], map: "conversation_participants_conversation_user_unique")
  @@index([providerProfileId])
  @@index([userId])
}

model conversations {
  id                        String                      @id
  requestId                 String?
  bookingId                 String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  deletedAt                 DateTime?
  conversation_participants conversation_participants[]
  bookings                  bookings?                   @relation(fields: [bookingId], references: [id])
  service_requests          service_requests?           @relation(fields: [requestId], references: [id])
  messages                  messages[]

  @@index([bookingId])
  @@index([deletedAt])
  @@index([requestId])
  @@index([updatedAt])
}

model messages {
  id             String                      @id
  conversationId String
  senderUserId   String?
  senderRole     ConversationParticipantRole
  body           String
  createdAt      DateTime                    @default(now())
  deletedAt      DateTime?
  conversations  conversations               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  users          User?                       @relation(fields: [senderUserId], references: [id])

  @@index([conversationId, createdAt])
  @@index([deletedAt])
}

model notifications {
  id           String                    @id
  userId       String
  type         NotificationType
  title        String
  body         String
  resourceType NotificationResourceType?
  resourceId   String?
  deepLink     String?
  metadata     Json?
  readAt       DateTime?
  createdAt    DateTime                  @default(now())
  deletedAt    DateTime?
  users        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([resourceType, resourceId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model provider_profiles {
  id                        String                      @id
  userId                    String?                     @unique
  displayName               String
  initials                  String
  avatarUrl                 String?
  ratingAvg                 Float                       @default(0)
  reviewCount               Int                         @default(0)
  completedJobs             Int                         @default(0)
  verified                  Boolean                     @default(false)
  topPro                    Boolean                     @default(false)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  deletedAt                 DateTime?
  bids                      bids[]
  bookings                  bookings[]
  conversation_participants conversation_participants[]
  users                     User?                       @relation(fields: [userId], references: [id])

  @@index([deletedAt])
}

model service_categories {
  id               String             @id
  slug             String             @unique
  labelEn          String
  labelAr          String
  icon             String
  sortOrder        Int                @default(0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  deletedAt        DateTime?
  service_requests service_requests[]

  @@index([deletedAt])
  @@index([isActive, sortOrder])
}

model service_request_events {
  id               String                  @id
  requestId        String
  actorUserId      String?
  type             ServiceRequestEventType
  metadata         Json?
  createdAt        DateTime                @default(now())
  users            User?                   @relation(fields: [actorUserId], references: [id])
  service_requests service_requests        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([type, createdAt])
}

model service_requests {
  id                     String                   @id
  seekerUserId           String
  categoryId             String?
  customServiceText      String?
  description            String?
  status                 ServiceRequestStatus     @default(OPEN_FOR_BIDS)
  scheduleType           ScheduleType
  scheduledAt            DateTime?
  addressId              String?
  addressSnapshot        Json
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  deletedAt              DateTime?
  bids                   bids[]
  bookings               bookings[]
  conversations          conversations[]
  service_request_events service_request_events[]
  addresses              addresses?               @relation(fields: [addressId], references: [id])
  service_categories     service_categories?      @relation(fields: [categoryId], references: [id])
  users                  User                     @relation(fields: [seekerUserId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([createdAt])
  @@index([seekerUserId, deletedAt])
  @@index([seekerUserId, status])
  @@index([status])
}

model user_profiles {
  id          String   @id
  userId      String   @unique
  avatarUrl   String?
  phoneNumber String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  city        String?
  users       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DELETED
}

enum ClientKind {
  WEB
  MOBILE
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
  REGISTRATION_OTP
}

enum AuditEventType {
  USER_REGISTERED
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_RESENT
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  REFRESH_ROTATED
  REFRESH_REPLAY
  SESSION_REVOKED
  MFA_ENROLLED
  MFA_DISABLED
  MFA_CHALLENGE_FAILED
  MFA_BACKUP_USED
  OAUTH_LINKED
  ROLE_ASSIGNED
  ROLE_REVOKED
}

enum AddressType {
  HOME
  WORK
  CUSTOM
}

enum BidBadge {
  BEST_MATCH
  BEST_VALUE
  FASTEST
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingEventType {
  BOOKING_CREATED
  BOOKING_CANCELLED
  BOOKING_STATUS_CHANGED
  BOOKING_RESCHEDULED
}

enum BookingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ConversationParticipantRole {
  SEEKER
  PROVIDER
  SYSTEM
}

enum NotificationResourceType {
  REQUEST
  BID
  BOOKING
  CONVERSATION
  REVIEW
}

enum NotificationType {
  BID_RECEIVED
  BID_ACCEPTED
  BOOKING_CREATED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  MESSAGE_RECEIVED
  REVIEW_REQUESTED
  SYSTEM
}

enum PricingType {
  HOURLY
  FIXED
}

enum ScheduleType {
  ASAP
  LATER
}

enum ServiceRequestEventType {
  REQUEST_CREATED
  REQUEST_UPDATED
  REQUEST_CANCELLED
  REQUEST_REOPENED
}

enum ServiceRequestStatus {
  OPEN_FOR_BIDS
  BID_ACCEPTED
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
