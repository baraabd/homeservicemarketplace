// ── Sprint 6: transactional outbox ─────────────────────────────────────────
//
// Fan-out used to run post-commit, in the request thread, as a best-effort
// loop that logged and swallowed every failure. That is at-most-once
// delivery with no record: if the process died between the domain commit and
// the fan-out — or if a single recipient write failed — the notification was
// simply lost, and nothing anywhere knew it should have existed.
//
// An outbox row is written in the SAME transaction as the domain mutation, so
// the event and the state change commit or roll back together. A separate
// worker then delivers it with retries. Delivery becomes at-least-once, and
// handler-level idempotency (OutboxHandlerRun) makes the observable EFFECT
// exactly-once.
//
// See docs/adr/0004-transactional-outbox.md.
enum OutboxStatus {
  // Waiting to be claimed. `availableAt` gates when it becomes eligible,
  // which is what implements the retry backoff.
  PENDING
  // Claimed by a worker and in flight. A row stuck here past the visibility
  // timeout was orphaned by a crashed worker and is reclaimed.
  PROCESSING
  // Delivered. Retained briefly for auditing, then reaped by the cleanup job.
  PROCESSED
  // Exhausted every retry. Terminal, and deliberately NOT auto-reaped: a
  // dead letter is evidence, and deleting it destroys the only record that
  // the event existed.
  DEAD
}

model OutboxEvent {
  id            String       @id @default(cuid())
  // What the event is about — ("ServiceRequest", "<id>"). Lets an operator
  // answer "what happened to request X" without scanning payloads.
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  // Optional caller-supplied idempotency key for the PRODUCER side: a retried
  // domain mutation that enqueues the same logical event twice collapses to
  // one row instead of fanning out twice.
  dedupeKey     String?      @unique
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(8)
  // When this row becomes claimable. Retry backoff is implemented by pushing
  // this into the future rather than by sleeping a worker.
  availableAt   DateTime     @default(now())
  claimedAt     DateTime?
  claimedBy     String?
  lastError     String?      @db.Text
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  handlerRuns   OutboxHandlerRun[]

  // The claim query: WHERE status = ? AND availableAt <= now() ORDER BY
  // availableAt, id. Composite so the ordering is served by the index and
  // the claim does not sort the backlog on every poll.
  @@index([status, availableAt])
  // Reclaiming rows orphaned by a crashed worker.
  @@index([status, claimedAt])
  // "What happened to this aggregate" — operator forensics.
  @@index([aggregateType, aggregateId])
}

// Idempotency ledger. One row per (event, handler) pair, inserted INSIDE the
// handler's own transaction alongside its effects.
//
// This is what turns at-least-once delivery into exactly-once effect. A
// redelivery — after a crash, a claim timeout, or two workers racing — hits
// the composite primary key, the insert conflicts, and the handler's work is
// skipped rather than repeated. Because the marker and the effects share one
// transaction, there is no window where one exists without the other.
model OutboxHandlerRun {
  eventId   String
  handler   String
  createdAt DateTime    @default(now())
  event     OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, handler])
}

// ── Sprint 7: provider lifecycle axes ──────────────────────────────────────
// docs/adr/0005-provider-lifecycle-axes.md
//
// Six axes, one enum each. They are independent on purpose: no value of one
// may be derived from another, which is exactly what the single legacy
// `ProviderProfileStatus` got wrong.

/// Axis 1 — is the application complete and submitted?
/// NOT_STARTED -> DRAFT -> SUBMITTED -> ACCEPTED | RETURNED -> DRAFT
enum ProviderOnboardingState {
  NOT_STARTED
  DRAFT
  SUBMITTED
  /// Sprint 8 — the wizard was completed and validated, and identity
  /// documents are the only thing outstanding.
  ///
  /// A DISTINCT state rather than a flavour of SUBMITTED, because it is where
  /// a valid submission lands and it must be unmistakable that arriving here
  /// grants NOTHING: no marketplace access, no work-access grant, no verified
  /// badge. It sits between SUBMITTED and ACCEPTED precisely so that
  /// "application complete" and "approved to work" can never be read as the
  /// same fact — which is the conflation ADR 0005 exists to undo.
  DOCUMENTS_REQUIRED
  ACCEPTED
  /// Sent back for changes. NOT a conduct decision — a returned applicant is
  /// in good standing and may edit and resubmit.
  RETURNED
}

/// Axis 2 — have we confirmed who they are?
///
/// Sprint 7 writes UNVERIFIED for every existing row, approved ones included.
/// No document flow exists yet; claiming otherwise would fabricate an audit
/// trail for thousands of providers.
enum ProviderVerificationState {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  /// A previously-verified document lapsed. Distinct from REJECTED: nobody
  /// judged them badly, time simply passed.
  EXPIRED
}

/// Axis 3 — standing on the marketplace.
///
/// Distinct from ACCOUNT standing (User.status), which outranks it: a
/// provider can be SUSPENDED here with a healthy account (they remain a
/// seeker), and an account can be suspended while this says GOOD.
enum ProviderStandingState {
  GOOD
  UNDER_REVIEW
  RESTRICTED
  SUSPENDED
  /// Terminal. No transition out.
  TERMINATED
}

/// Axis 5 — what they have paid for. Inert this sprint.
/// MUST NOT grant a capability: a paid tier that needs to unlock an action
/// does so by issuing a work-access grant, so the decision stays auditable.
enum ProviderSubscriptionTier {
  NONE
  BASIC
  PRO
  ELITE
}

/// Where a profile's axis values came from.
///
/// LEGACY_APPROVED is the load-bearing one: it means "approved under the old
/// single-status process, identity never verified". It is deliberately not a
/// synonym for VERIFIED, so these rows stay findable when verification
/// becomes a requirement for work access.
enum ProviderLifecycleSource {
  /// Written by post-Sprint-7 application code.
  NATIVE
  LEGACY_DRAFT
  /// Submitted under a policy version we hold no snapshot for.
  LEGACY_PENDING
  LEGACY_APPROVED
  LEGACY_SUSPENDED
  LEGACY_REJECTED
}

/// Axis 4 — a time-bounded permission to take work.
enum ProviderWorkAccessStatus {
  ACTIVE
  /// Withdrawn before its natural end.
  REVOKED
  /// Past expiresAt. Stored for history; expiry itself is computed from the
  /// timestamps, never from this column.
  EXPIRED
}

/// An immutable record of ONE onboarding submission.
///
/// Reviewers must judge what was actually submitted, under the policy in
/// force at the time — not what the mutable ProviderProfile looks like when
/// they happen to open it. Without this, a provider can edit their profile
/// after submitting and a reviewer approves something nobody sent, and a
/// policy change silently invalidates every pending application.
///
/// Append-only: a resubmission writes a NEW row. Nothing here is ever updated
/// except the decision fields, which are written once.
model ProviderOnboardingSubmission {
  id                String          @id @default(cuid())
  providerProfileId String
  /// The completeness policy in force when this was submitted, so a later
  /// rule change cannot retroactively fail a queued application.
  policyVersion     String
  /// Verbatim copy of the fields the policy evaluated. JSON because its shape
  /// is versioned by policyVersion, not by the schema.
  snapshot          Json
  /// Issues outstanding at submission time. Empty for a valid submission;
  /// populated when an admin force-submits on a provider's behalf.
  issues            Json?
  submittedAt       DateTime        @default(now())
  submittedByUserId String?

  /// Decision fields, written once when a reviewer acts.
  decidedAt         DateTime?
  decidedByUserId   String?
  decision          ProviderOnboardingState?
  decisionNote      String?         @db.Text

  createdAt         DateTime        @default(now())

  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  /// "The newest submission for this provider" — the review queue's hot path.
  @@index([providerProfileId, submittedAt])
  /// "Everything still awaiting a decision", oldest first.
  @@index([decidedAt, submittedAt])
}

/// Axis 4 — a grant of work access, bounded in time.
///
/// Access is a GRANT rather than a status because the question is "may they
/// work RIGHT NOW", and now moves without anyone editing a row. A provider
/// has access iff a row exists with revokedAt IS NULL and
/// now() BETWEEN grantedAt AND COALESCE(expiresAt, 'infinity').
///
/// Expiry therefore needs no writer. A nightly job that flips a status column
/// is a job that can fail, and its failure grants access nobody authorised.
///
/// Sprint 7 creates the table and the read path; it is NOT yet consulted for
/// authorization (docs/adr/0007) — no grants exist, so enforcing it would
/// lock out every provider.
model ProviderWorkAccessGrant {
  id                String                   @id @default(cuid())
  providerProfileId String
  status            ProviderWorkAccessStatus @default(ACTIVE)
  /// Why this grant exists — e.g. LEGACY_APPROVED, VERIFIED_DOCUMENTS,
  /// MANUAL_OVERRIDE. A string rather than an enum because the set of
  /// justifications will grow faster than the schema should.
  reason            String
  grantedAt         DateTime                 @default(now())
  grantedByUserId   String?
  /// Null means open-ended. Deliberately nullable rather than a far-future
  /// sentinel, so "no expiry" is queryable as IS NULL instead of relying on
  /// everyone remembering the sentinel.
  expiresAt         DateTime?
  revokedAt         DateTime?
  revokedByUserId   String?
  revokedReason     String?

  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  providerProfile   ProviderProfile          @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  /// The authorization read: live grants for one provider, newest expiry
  /// first. Leading equality on the two columns every check carries.
  @@index([providerProfileId, status, expiresAt])
  /// Sweeping grants that have aged out, for the reporting job.
  @@index([status, expiresAt])
}

// ── Sprint 8: provider onboarding journey ──────────────────────────────────
// docs/adr/0008-category-hierarchy-and-onboarding-draft.md

/// Individual tradesperson vs registered business. Not cosmetic: it changes
/// which other fields the completeness policy requires, so it cannot be
/// inferred or defaulted.
enum ProviderType {
  INDIVIDUAL
  BUSINESS
}

/// How a provider reaches a job. Stable CODES rather than free text so the
/// value survives translation and can be filtered on; the label lives in the
/// client's i18n bundle, keyed by this code.
enum ProviderTransportMode {
  ON_FOOT
  MOTORCYCLE
  CAR
  VAN
  TRUCK
  PUBLIC_TRANSPORT
}

/// A weekly recurring window in which the provider works.
///
/// Modelled as day + minute-of-day intervals rather than one broad enum
/// (weekdays, evenings) because the marketplace has to answer "are they free
/// at 14:30 on Tuesday", and a bucket cannot. Minutes-from-midnight rather
/// than a time type: integer-comparable, trivially indexable, and carrying no
/// timezone of its own — the zone is stored once on the interval, so a
/// provider who moves cities does not silently shift every window.
model ProviderAvailabilityInterval {
  id                String          @id @default(cuid())
  providerProfileId String
  /// 0 = Sunday … 6 = Saturday. Matches JS getDay(), so there is no
  /// conversion layer to get wrong.
  dayOfWeek         Int
  /// Minutes from local midnight, 0..1440. End is EXCLUSIVE, so 09:00-17:00
  /// is [540, 1020) and two adjacent windows can touch without overlapping.
  startMinute       Int
  endMinute         Int
  /// IANA zone, e.g. Asia/Damascus.
  timezone          String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  /// The availability read: one provider's whole week, in order.
  @@index([providerProfileId, dayOfWeek, startMinute])
  /// Exact duplicates of the same window are always a mistake. Declared here
  /// rather than left as raw SQL so Prisma owns it and the drift gate stays
  /// green; `map` keeps the descriptive name the migration created.
  ///
  /// This does NOT prevent partial overlap (09:00-12:00 beside 11:00-14:00) —
  /// that needs an EXCLUDE over int4range and the btree_gist extension, which
  /// is the sort of infrastructure change ADR 0003 declined to make without
  /// evidence. Overlap is validated in the service on every write and tested
  /// there; this closes the cheapest half for free.
  @@unique([providerProfileId, dayOfWeek, startMinute, endMinute], map: "provider_availability_no_exact_duplicate")
}

/// A piece of equipment a provider owns, from a controlled catalogue.
///
/// Codes rather than free text: van, Van, VAN and small van are one
/// capability, and matching cannot work if providers type it. Linked to a
/// category so the wizard offers plumbers plumbing equipment.
model EquipmentCatalogItem {
  id         String              @id @default(cuid())
  /// Stable, human-readable, never reused. The client keys i18n off this.
  code       String              @unique
  labelEn    String
  labelAr    String
  /// Null means it applies to every category — a ladder is a ladder.
  categoryId String?
  category   ServiceCategory?    @relation(fields: [categoryId], references: [id])
  isActive   Boolean             @default(true)
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  providers  ProviderEquipment[]

  @@index([categoryId, isActive, sortOrder])
  @@index([isActive, sortOrder])
}

model ProviderEquipment {
  providerProfileId String
  equipmentItemId   String
  createdAt         DateTime             @default(now())

  providerProfile   ProviderProfile      @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  equipmentItem     EquipmentCatalogItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  @@id([providerProfileId, equipmentItemId])
  @@index([equipmentItemId])
}

/// Normalised place references.
///
/// The existing free-text serviceAreaCity stays and stays authoritative for
/// matching — Sprint 6's cityKey plus bounded-Haversine strategy is untouched.
/// These add a CANONICAL spine so spellings resolve to one row that districts
/// can hang off, which free text cannot support.
model City {
  id            String                @id @default(cuid())
  /// btrim+lower match key — the SAME normalisation as Sprint 6's
  /// locationCityKey, so the two join without a translation layer.
  cityKey       String                @unique
  labelEn       String
  labelAr       String
  countryCode   String
  isActive      Boolean               @default(true)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  districts     District[]
  providerAreas ProviderServiceArea[]

  @@index([countryCode, isActive, sortOrder])
}

model District {
  id            String                @id @default(cuid())
  cityId        String
  districtKey   String
  labelEn       String
  labelAr       String
  isActive      Boolean               @default(true)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  city          City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  neighborhoods Neighborhood[]
  providerAreas ProviderServiceArea[]

  /// Unique WITHIN a city, not globally — Downtown exists in many cities.
  @@unique([cityId, districtKey])
  @@index([cityId, isActive, sortOrder])
}

model Neighborhood {
  id              String                @id @default(cuid())
  districtId      String
  neighborhoodKey String
  labelEn         String
  labelAr         String
  isActive        Boolean               @default(true)
  sortOrder       Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  district        District              @relation(fields: [districtId], references: [id], onDelete: Cascade)
  providerAreas   ProviderServiceArea[]

  @@unique([districtId, neighborhoodKey])
  @@index([districtId, isActive, sortOrder])
}

/// Where a provider will actually travel, at whatever granularity they chose.
///
/// Exactly one of city / district / neighborhood is set, enforced by a CHECK
/// constraint in the migration: a row with two set has no defined meaning and
/// would be counted twice by every area query.
model ProviderServiceArea {
  id                String          @id @default(cuid())
  providerProfileId String
  cityId            String?
  districtId        String?
  neighborhoodId    String?
  createdAt         DateTime        @default(now())

  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  city              City?           @relation(fields: [cityId], references: [id])
  district          District?       @relation(fields: [districtId], references: [id])
  neighborhood      Neighborhood?   @relation(fields: [neighborhoodId], references: [id])

  @@index([providerProfileId])
  @@index([cityId])
  @@index([districtId])
  @@index([neighborhoodId])
}

/// The wizard's saved state — what makes resume-from-last-step possible.
///
/// One draft per provider. `data` is a versioned JSON bag rather than fifty
/// nullable columns because a half-filled wizard is genuinely unstructured:
/// modelling every intermediate state would mean a migration each time a step
/// is reordered. COMMITTED values live in typed columns on ProviderProfile and
/// its relations; this is scratch space with a lifetime of one application.
model ProviderOnboardingDraft {
  id                String          @id @default(cuid())
  providerProfileId String          @unique
  /// The step to resume on.
  currentStep       String
  /// Steps the SERVER has accepted as complete. Never client-asserted, or a
  /// client could mark itself finished.
  completedSteps    String[]        @default([])
  data              Json            @default("{}")
  /// Optimistic concurrency token. Every PATCH presents the version it read;
  /// a mismatch is a 409 rather than a silent overwrite. Two tabs open on one
  /// wizard is the ordinary case, not the exotic one.
  version           Int             @default(0)
  /// The completeness policy in force, so a draft is not silently re-judged
  /// under a newer version mid-flight.
  policyVersion     String
  lastSavedAt       DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
}

/// Append-only history for platform settings.
///
/// PlatformSetting keeps only the current value and who last touched it, which
/// cannot answer "what was the threshold when this provider was rejected?" —
/// the question that actually gets asked. Settings that gate onboarding need a
/// trail, so every write appends here.
model PlatformSettingHistory {
  id            String   @id @default(cuid())
  key           String
  previousValue Json?
  newValue      Json
  changedBy     String?
  changedAt     DateTime @default(now())
  /// Justification captured at change time.
  reason        String?

  @@index([key, changedAt])
  @@index([changedAt])
}
