{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::${BUCKET}", "arn:aws:s3:::${BUCKET}/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "CdnReadsPublicationPrefixesOnly",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": ["arn:aws:s3:::${BUCKET}/requests/*", "arn:aws:s3:::${BUCKET}/avatars/*"],
      "Condition": { "StringEquals": { "AWS:SourceArn": "${CDN_DISTRIBUTION_ARN}" } }
    }
  ]
}
