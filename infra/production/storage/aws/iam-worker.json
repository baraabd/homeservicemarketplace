{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RestrictedEvidenceReadAndErase",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": ["arn:aws:s3:::${RESTRICTED_BUCKET}/verification/*"]
    },
    {
      "Sid": "RestrictedEvidenceVersionInventory",
      "Effect": "Allow",
      "Action": ["s3:ListBucketVersions"],
      "Resource": ["arn:aws:s3:::${RESTRICTED_BUCKET}"],
      "Condition": { "StringLike": { "s3:prefix": ["verification/*"] } }
    },
    {
      "Sid": "PublicMediaCleanup",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::${PUBLIC_BUCKET}/requests/*",
        "arn:aws:s3:::${PUBLIC_BUCKET}/avatars/*",
        "arn:aws:s3:::${PUBLIC_BUCKET}/portfolio/*",
        "arn:aws:s3:::${PORTFOLIO_STAGING_BUCKET}/portfolio-staging/*"
      ]
    },
    {
      "Sid": "StorageRootMarkers",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::${PUBLIC_BUCKET}/.hsm-storage-root.json",
        "arn:aws:s3:::${PORTFOLIO_STAGING_BUCKET}/.hsm-storage-root.json",
        "arn:aws:s3:::${RESTRICTED_BUCKET}/.hsm-storage-root.json"
      ]
    },
    {
      "Sid": "PrivateBucketKms",
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": ["${PRIVATE_KMS_KEY_ARN}"]
    }
  ]
}
