{
  "info": {
    "name": "FixNow Sprint 6.2 Admin Provider Verification",
    "description": "Full admin Pro Verification workflow (Sprint 6.2 refined).\n\nDrives:\n  • GET /v1/admin/providers (list, default PENDING_REVIEW)\n  • GET /v1/admin/providers?status=PENDING_REVIEW (filter)\n  • GET /v1/admin/providers/:providerProfileId (detail — now carries reviewNotes)\n  • GET /v1/admin/providers/:providerProfileId/audit (verification history)\n  • PATCH /v1/admin/providers/:providerProfileId/review-notes (admin-private)\n  • POST /v1/admin/providers/:providerProfileId/{approve,reject,suspend,reactivate}\n  • Negative customer token + no-token\n\nPrerequisites: {{adminToken}} from a logged-in admin, {{customerToken}} from a non-admin (the FixNow Provider Runtime collection's 01 — Auth folder populates both), and {{providerProfileId}} pointing at a profile in the dev DB. The mutation requests are status-conditional and tolerate 200 / 409 (idempotent re-runs).\n\nCollection-level guard rejects PrismaClient / SQL fragments / passwordHash / refreshToken / JWT_SECRET / DATABASE_URL on every response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "fixnow-sprint-6-2-admin-provider-verification"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{adminToken}}" }]
  },
  "variable": [
    { "key": "apiUrl", "value": "http://localhost:4000" },
    { "key": "apiVersion", "value": "v1" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const text = pm.response.text();",
          "pm.test('no Prisma/SQL/secret leak', () => {",
          "  pm.expect(text).to.not.match(/PrismaClient|column .* does not exist|SELECT |INSERT |UPDATE /i);",
          "  pm.expect(text).to.not.include('passwordHash');",
          "  pm.expect(text).to.not.include('mfaSecret');",
          "  pm.expect(text).to.not.include('refreshToken');",
          "  pm.expect(text).to.not.include('JWT_SECRET');",
          "  pm.expect(text).to.not.include('DATABASE_URL');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1) GET /v1/admin/providers",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('items array', () => pm.expect(body.items).to.be.an('array'));",
              "if (body.items.length > 0) {",
              "  const p = body.items[0];",
              "  pm.test('row has id + status + reviewNotes (Sprint 6.2)', () => {",
              "    pm.expect(p.id).to.be.a('string');",
              "    pm.expect(p.status).to.be.a('string');",
              "    pm.expect(p).to.have.property('reviewNotes');",
              "  });",
              "  pm.environment.set('providerProfileId', p.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2) GET /v1/admin/providers?status=PENDING_REVIEW",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers?status=PENDING_REVIEW"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('every row has status PENDING_REVIEW', () => {",
              "  for (const p of body.items) pm.expect(p.status).to.eql('PENDING_REVIEW');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3) GET /v1/admin/providers/:providerProfileId",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const p = pm.response.json();",
              "  pm.test('detail carries reviewNotes (Sprint 6.2)', () => pm.expect(p).to.have.property('reviewNotes'));",
              "  pm.test('detail does not leak passwordHash', () => pm.expect(JSON.stringify(p)).to.not.include('passwordHash'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4) GET /v1/admin/providers/:providerProfileId/audit",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}/audit"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('items array (may be empty)', () => pm.expect(body.items).to.be.an('array'));",
              "  pm.test('every audit row has id + type + createdAt', () => {",
              "    for (const e of body.items) {",
              "      pm.expect(e.id).to.be.a('string');",
              "      pm.expect(e.type).to.be.a('string');",
              "      pm.expect(e.createdAt).to.be.a('string');",
              "    }",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5) PATCH /v1/admin/providers/:providerProfileId/review-notes",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Client-Kind", "value": "mobile" }
        ],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}/review-notes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"runtime test note — Sprint 6.2\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('provider.reviewNotes echoes the saved value', () => pm.expect(body.provider.reviewNotes).to.eql('runtime test note — Sprint 6.2'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6a) POST /v1/admin/providers/:id/approve",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Client-Kind", "value": "mobile" }
        ],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}/approve",
        "body": { "mode": "raw", "raw": "{\n  \"note\": \"runtime approval\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 200 on first run (PENDING_REVIEW → ACTIVE), 409 on idempotent re-run, 404 on env mismatch.",
              "pm.test('status 200 / 404 / 409', () => pm.expect([200, 404, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  pm.test('provider.status === ACTIVE', () => pm.expect(pm.response.json().provider.status).to.eql('ACTIVE'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6b) POST /v1/admin/providers/:id/suspend",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Client-Kind", "value": "mobile" }
        ],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}/suspend",
        "body": { "mode": "raw", "raw": "{\n  \"reason\": \"runtime suspension\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 / 404 / 409', () => pm.expect([200, 404, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  pm.test('provider.status === SUSPENDED', () => pm.expect(pm.response.json().provider.status).to.eql('SUSPENDED'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6c) POST /v1/admin/providers/:id/reactivate",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Client-Kind", "value": "mobile" }
        ],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}/reactivate"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 / 404 / 409', () => pm.expect([200, 404, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  pm.test('provider.status === ACTIVE', () => pm.expect(pm.response.json().provider.status).to.eql('ACTIVE'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6d) POST /v1/admin/providers/:id/reject",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Client-Kind", "value": "mobile" }
        ],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}/reject",
        "body": { "mode": "raw", "raw": "{\n  \"reason\": \"runtime rejection\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 / 404 / 409', () => pm.expect([200, 404, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  pm.test('provider.status === REJECTED', () => pm.expect(pm.response.json().provider.status).to.eql('REJECTED'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "7) GET /v1/admin/providers (customer token → 403)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{customerToken}}" }]
        },
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 403', () => pm.response.to.have.status(403));",
              "pm.test('FORBIDDEN code', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
            ]
          }
        }
      ]
    },
    {
      "name": "8) GET /v1/admin/providers (no token → 401)",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test('AUTH_INVALID_CREDENTIALS code', () => pm.expect(pm.response.json().error.code).to.eql('AUTH_INVALID_CREDENTIALS'));"
            ]
          }
        }
      ]
    }
  ]
}
