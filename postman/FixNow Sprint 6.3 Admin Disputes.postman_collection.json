{
  "info": {
    "name": "FixNow Sprint 6.3 Admin Disputes",
    "description": "Full admin Disputes workflow (Sprint 6.3 refined).\n\nDrives:\n  • GET /v1/admin/disputes (list)\n  • GET /v1/admin/disputes?status=OPEN (filter)\n  • GET /v1/admin/disputes/:disputeId (detail — carries recentEvents)\n  • PATCH /v1/admin/disputes/:disputeId (status / priority / description)\n  • POST /v1/admin/disputes/:disputeId/resolve\n  • Customer-token negative → 403\n  • No-token negative → 401\n\nPrerequisites: {{adminToken}} (logged-in admin), {{customerToken}} (non-admin), and {{disputeId}} pointing at a dispute in the dev DB. The PATCH + resolve requests are status-conditional and tolerate 200 / 409 (idempotent re-runs).\n\nCollection-level guard rejects PrismaClient / SQL fragments / passwordHash / refreshToken / JWT_SECRET / DATABASE_URL on every response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "fixnow-sprint-6-3-admin-disputes"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{adminToken}}" }]
  },
  "variable": [
    { "key": "apiUrl", "value": "http://localhost:4000" },
    { "key": "apiVersion", "value": "v1" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const text = pm.response.text();",
          "pm.test('no Prisma/SQL/secret leak', () => {",
          "  pm.expect(text).to.not.match(/PrismaClient|column .* does not exist|SELECT |INSERT |UPDATE /i);",
          "  pm.expect(text).to.not.include('passwordHash');",
          "  pm.expect(text).to.not.include('mfaSecret');",
          "  pm.expect(text).to.not.include('refreshToken');",
          "  pm.expect(text).to.not.include('JWT_SECRET');",
          "  pm.expect(text).to.not.include('DATABASE_URL');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1) GET /v1/admin/disputes",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/disputes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('items array', () => pm.expect(body.items).to.be.an('array'));",
              "if (body.items.length > 0) {",
              "  const d = body.items[0];",
              "  pm.test('row carries id + status + priority (Sprint 6.3)', () => {",
              "    pm.expect(d.id).to.be.a('string');",
              "    pm.expect(d.status).to.be.a('string');",
              "    pm.expect(d.priority).to.be.a('string');",
              "  });",
              "  pm.environment.set('disputeId', d.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2) GET /v1/admin/disputes?status=OPEN",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/disputes?status=OPEN"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('every row has status OPEN', () => {",
              "  for (const d of body.items) pm.expect(d.status).to.eql('OPEN');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3) GET /v1/admin/disputes/:disputeId",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/disputes/{{disputeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const d = pm.response.json();",
              "  pm.test('detail carries priority (Sprint 6.3)', () => pm.expect(d.priority).to.be.a('string'));",
              "  pm.test('detail carries recentEvents array', () => pm.expect(d.recentEvents).to.be.an('array'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4) PATCH /v1/admin/disputes/:disputeId",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Client-Kind", "value": "mobile" }
        ],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/disputes/{{disputeId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"priority\": \"HIGH\",\n  \"description\": \"runtime test — bumped to HIGH\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 200 on first run; 409 if the dispute is already terminal; 404 on env mismatch.",
              "pm.test('status 200 / 404 / 409', () => pm.expect([200, 404, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('mutation echoes the dispute envelope', () => pm.expect(body.dispute).to.exist);",
              "  pm.test('priority echoes HIGH', () => pm.expect(body.dispute.priority).to.eql('HIGH'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5) POST /v1/admin/disputes/:disputeId/resolve",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Client-Kind", "value": "mobile" }
        ],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/disputes/{{disputeId}}/resolve",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"RESOLVED_REFUND\",\n  \"resolution\": \"runtime test — full refund\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 / 404 / 409', () => pm.expect([200, 404, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('dispute.status === RESOLVED_REFUND', () => pm.expect(body.dispute.status).to.eql('RESOLVED_REFUND'));",
              "  pm.test('resolvedAt is set', () => pm.expect(body.dispute.resolvedAt).to.be.a('string'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6) GET /v1/admin/disputes (customer token → 403)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{customerToken}}" }]
        },
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/disputes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 403', () => pm.response.to.have.status(403));",
              "pm.test('FORBIDDEN code', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
            ]
          }
        }
      ]
    },
    {
      "name": "7) GET /v1/admin/disputes (no token → 401)",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/disputes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test('AUTH_INVALID_CREDENTIALS code', () => pm.expect(pm.response.json().error.code).to.eql('AUTH_INVALID_CREDENTIALS'));"
            ]
          }
        }
      ]
    }
  ]
}
