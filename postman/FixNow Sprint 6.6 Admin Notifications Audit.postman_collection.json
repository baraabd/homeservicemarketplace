{
  "info": {
    "name": "FixNow Sprint 6.6 Admin Notifications Audit",
    "description": "Read-only admin notifications + audit logs (Sprint 6.6).\n\nDrives:\n  • GET /v1/admin/notifications (admin's own; experience='admin')\n  • POST /v1/admin/notifications/:id/read\n  • GET /v1/admin/audit-logs (canonical; redacted metadata)\n  • GET /v1/admin/audit-logs?action=ADMIN_PROVIDER_APPROVED\n  • Customer-token negative → 403\n  • No-token negative → 401\n\nServer redacts passwordHash / JWT_SECRET / DATABASE_URL / refreshToken / STRIPE_SECRET keys in metadata before they leave the API. The collection-level guard double-checks every response body.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "fixnow-sprint-6-6-admin-notifications-audit"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{adminToken}}" }]
  },
  "variable": [
    { "key": "apiUrl", "value": "http://localhost:4000" },
    { "key": "apiVersion", "value": "v1" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const text = pm.response.text();",
          "pm.test('no Prisma/SQL/secret leak', () => {",
          "  pm.expect(text).to.not.match(/PrismaClient|column .* does not exist|SELECT |INSERT |UPDATE /i);",
          "  pm.expect(text).to.not.include('passwordHash');",
          "  pm.expect(text).to.not.include('refreshToken');",
          "  pm.expect(text).to.not.include('JWT_SECRET');",
          "  pm.expect(text).to.not.include('DATABASE_URL');",
          "  pm.expect(text).to.not.include('STRIPE_SECRET');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1) GET /v1/admin/notifications",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/notifications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('items array', () => pm.expect(body.items).to.be.an('array'));",
              "pm.test('nextCursor is string|null', () => {",
              "  pm.expect(body.nextCursor === null || typeof body.nextCursor === 'string').to.eql(true);",
              "});",
              "pm.test('every notification deepLink starts with /admin/ (experience=admin)', () => {",
              "  for (const n of body.items) {",
              "    if (n.deepLink) pm.expect(n.deepLink.startsWith('/admin/')).to.eql(true);",
              "  }",
              "});",
              "if (body.items.length > 0) {",
              "  pm.environment.set('notificationId', body.items[0].id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2) POST /v1/admin/notifications/:id/read",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Client-Kind", "value": "mobile" }
        ],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/notifications/{{notificationId}}/read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 200 on first run; idempotent re-mark on already-read returns 200 too.",
              "// 404 when the env doesn't have a notificationId set.",
              "pm.test('status 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  pm.test('notification.readAt set', () => {",
              "    pm.expect(pm.response.json().notification.readAt).to.be.a('string');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3) GET /v1/admin/audit-logs",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/audit-logs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('items array', () => pm.expect(body.items).to.be.an('array'));",
              "pm.test('every row carries actor + action (renamed wire fields)', () => {",
              "  for (const r of body.items) {",
              "    pm.expect(r.action).to.be.a('string');",
              "    pm.expect(r).to.have.property('actor');",
              "    pm.expect(r).to.have.property('metadata');",
              "  }",
              "});",
              "pm.test('metadata is redacted (no leaked secret strings)', () => {",
              "  const text = pm.response.text();",
              "  pm.expect(text).to.not.include('passwordHash\":\"');",
              "  pm.expect(text).to.not.include('JWT_SECRET\":\"');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4) GET /v1/admin/audit-logs?action=ADMIN_PROVIDER_APPROVED",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/audit-logs?action=ADMIN_PROVIDER_APPROVED"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('every row matches the action filter', () => {",
              "  for (const r of body.items) pm.expect(r.action).to.eql('ADMIN_PROVIDER_APPROVED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5) GET /v1/admin/audit-logs (customer token → 403)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{customerToken}}" }]
        },
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/audit-logs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 403', () => pm.response.to.have.status(403));",
              "pm.test('FORBIDDEN code', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6) GET /v1/admin/audit-logs (no token → 401)",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/audit-logs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test('AUTH_INVALID_CREDENTIALS code', () => pm.expect(pm.response.json().error.code).to.eql('AUTH_INVALID_CREDENTIALS'));"
            ]
          }
        }
      ]
    }
  ]
}
