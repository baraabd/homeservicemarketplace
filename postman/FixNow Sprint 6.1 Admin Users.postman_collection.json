{
  "info": {
    "name": "FixNow Sprint 6.1 Admin Users",
    "description": "Admin User Control end-to-end (Sprint 6.1).\n\nDrives:\n  • GET /v1/admin/users (list)\n  • GET /v1/admin/users?limit=1 (page-of-one sanity)\n  • GET /v1/admin/users?query=… (search)\n  • GET /v1/admin/users/:userId (detail)\n  • PATCH /v1/admin/users/:userId/status (canonical Sprint 6.1 mutation)\n  • GET /v1/admin/roles (filter chip data)\n  • Negative: customer token → 403 on admin endpoint\n  • Negative: no token → 401\n\nPrerequisites: {{adminToken}} from a logged-in admin and {{customerToken}} from a logged-in non-admin (the FixNow Provider Runtime collection's 01 — Auth folder populates both). The PATCH step targets {{userId}} — set it to a non-admin user the seeker harness already creates, OR leave empty to skip the mutation. Re-running the PATCH against an already-suspended user is intentionally idempotent on the API; the test asserts 200.\n\nCollection-level guard rejects PrismaClient / SQL fragment / passwordHash / refreshToken / JWT_SECRET / DATABASE_URL on every response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "fixnow-sprint-6-1-admin-users"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{adminToken}}" }]
  },
  "variable": [
    { "key": "apiUrl", "value": "http://localhost:4000" },
    { "key": "apiVersion", "value": "v1" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const text = pm.response.text();",
          "pm.test('no Prisma/SQL/secret leak', () => {",
          "  pm.expect(text).to.not.match(/PrismaClient|column .* does not exist|SELECT |INSERT |UPDATE /i);",
          "  pm.expect(text).to.not.include('passwordHash');",
          "  pm.expect(text).to.not.include('mfaSecret');",
          "  pm.expect(text).to.not.include('refreshToken');",
          "  pm.expect(text).to.not.include('JWT_SECRET');",
          "  pm.expect(text).to.not.include('DATABASE_URL');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1) GET /v1/admin/users",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('items array', () => pm.expect(body.items).to.be.an('array'));",
              "pm.test('nextCursor is string or null', () => {",
              "  pm.expect(body.nextCursor === null || typeof body.nextCursor === 'string').to.eql(true);",
              "});",
              "if (body.items.length > 0) {",
              "  pm.environment.set('adminUserListFirstId', body.items[0].id);",
              "  pm.test('user shape: id + email + status + roles[]', () => {",
              "    const u = body.items[0];",
              "    pm.expect(u.id).to.be.a('string');",
              "    pm.expect(u.email).to.be.a('string');",
              "    pm.expect(u.status).to.be.a('string');",
              "    pm.expect(u.roles).to.be.an('array');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2) GET /v1/admin/users?limit=1",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/users?limit=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('page-of-one honours limit', () => pm.expect(body.items.length).to.be.at.most(1));",
              "pm.test('nextCursor present when more rows exist', () => {",
              "  if (body.items.length === 1) pm.expect(body.nextCursor === null || typeof body.nextCursor === 'string').to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3) GET /v1/admin/users?query=test",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/users?query=test"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('items array (may be empty)', () => pm.expect(body.items).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "4) GET /v1/admin/users/:userId",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 or 404 (depending on env)', () => {",
              "  pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 200) {",
              "  const u = pm.response.json();",
              "  pm.test('detail shape: id + email + status', () => {",
              "    pm.expect(u.id).to.be.a('string');",
              "    pm.expect(u.email).to.be.a('string');",
              "    pm.expect(u.status).to.be.a('string');",
              "  });",
              "  pm.test('detail does not leak passwordHash / mfaSecret', () => {",
              "    const text = pm.response.text();",
              "    pm.expect(text).to.not.include('passwordHash');",
              "    pm.expect(text).to.not.include('mfaSecret');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5) PATCH /v1/admin/users/:userId/status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Client-Kind", "value": "mobile" }
        ],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/users/{{userId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"SUSPENDED\",\n  \"reason\": \"runtime test — suspend then restore\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Idempotent: suspending an already-suspended user still returns 200.",
              "// 400 is acceptable when the userId resolves to the admin themselves",
              "// (cannot disable self).",
              "pm.test('status 200, 400 (self), or 404 (env mismatch)', () => {",
              "  pm.expect([200, 400, 404]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('user.status === SUSPENDED', () => pm.expect(body.user.status).to.eql('SUSPENDED'));",
              "  pm.test('user.isActive === false', () => pm.expect(body.user.isActive).to.eql(false));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6) GET /v1/admin/roles",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/roles"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('items array', () => pm.expect(body.items).to.be.an('array'));",
              "pm.test('every row has id + name', () => {",
              "  for (const r of body.items) {",
              "    pm.expect(r.id).to.be.a('string');",
              "    pm.expect(r.name).to.be.a('string');",
              "  }",
              "});",
              "pm.test(\"seeded 'admin' role present\", () => {",
              "  pm.expect(body.items.some(r => r.name === 'admin')).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7) GET /v1/admin/users (customer token → 403)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{customerToken}}" }]
        },
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 403', () => pm.response.to.have.status(403));",
              "pm.test('FORBIDDEN error code', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
            ]
          }
        }
      ]
    },
    {
      "name": "8) GET /v1/admin/users (no token → 401)",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [{ "key": "X-Client-Kind", "value": "mobile" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test('AUTH_INVALID_CREDENTIALS code', () => pm.expect(pm.response.json().error.code).to.eql('AUTH_INVALID_CREDENTIALS'));"
            ]
          }
        }
      ]
    }
  ]
}
