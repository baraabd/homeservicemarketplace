{
  "info": {
    "name": "FixNow Sprint 5.1.4 Provider Approval Gate",
    "description": "Admin-controlled ProviderProfile.status management. Run order: list (captures providerProfileId) -> detail -> approve -> reject -> suspend -> reactivate -> negative cross-role + no-token. Requires {{adminToken}} populated by an earlier IAM login; the negative folder uses {{providerToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "fixnow-sprint-5-1-4-provider-approval-gate"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{adminToken}}" }]
  },
  "variable": [
    { "key": "apiUrl", "value": "http://localhost:4000" },
    { "key": "apiVersion", "value": "v1" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const text = pm.response.text();",
          "pm.test('No sensitive fields leaked', function () {",
          "  pm.expect(text).to.not.include('passwordHash');",
          "  pm.expect(text).to.not.include('refreshToken');",
          "  pm.expect(text).to.not.include('JWT_SECRET');",
          "  pm.expect(text).to.not.include('DATABASE_URL');",
          "  pm.expect(text).to.not.match(/PrismaClient|column .* does not exist/i);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1) GET /v1/admin/providers?status=PENDING_REVIEW",
      "request": {
        "method": "GET",
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers?status=PENDING_REVIEW"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('response is JSON', () => pm.response.to.be.json);",
              "const body = pm.response.json();",
              "pm.test('items array exists', () => pm.expect(body.items).to.be.an('array'));",
              "pm.test('nextCursor exists or is null', () => {",
              "  pm.expect(body).to.have.property('nextCursor');",
              "});",
              "if (body.items && body.items.length > 0) {",
              "  pm.environment.set('providerProfileId', body.items[0].id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2) GET /v1/admin/providers/:providerProfileId",
      "request": {
        "method": "GET",
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 or 404 (placeholder env)', () => {",
              "  pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('id matches', () => {",
              "    pm.expect(body.id).to.eql(pm.environment.get('providerProfileId'));",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3) POST /v1/admin/providers/:id/approve",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}/approve",
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200, 404, or 409', () => {",
              "  pm.expect([200, 404, 409]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('status field is ACTIVE', () => {",
              "    pm.expect(body.provider.status).to.eql('ACTIVE');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4) POST /v1/admin/providers/:id/reject",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}/reject",
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200, 404, or 409', () => {",
              "  pm.expect([200, 404, 409]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('status field is REJECTED', () => {",
              "    pm.expect(body.provider.status).to.eql('REJECTED');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5) POST /v1/admin/providers/:id/suspend",
      "description": "Note: suspend requires status=ACTIVE. After step 4 the provider is REJECTED, so this typically returns 409 unless the test seed pre-stages an ACTIVE provider for the suspend step. Tests accept either path.",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}/suspend",
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200, 404, or 409', () => {",
              "  pm.expect([200, 404, 409]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('status field is SUSPENDED', () => {",
              "    pm.expect(body.provider.status).to.eql('SUSPENDED');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6) POST /v1/admin/providers/:id/reactivate",
      "description": "Conditional on status=SUSPENDED. Returns 409 unless step 5 succeeded.",
      "request": {
        "method": "POST",
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers/{{providerProfileId}}/reactivate"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200, 404, or 409', () => {",
              "  pm.expect([200, 404, 409]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('status field is ACTIVE', () => {",
              "    pm.expect(body.provider.status).to.eql('ACTIVE');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "7) Negative — provider token cannot list admin providers",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{providerToken}}" }]
        },
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401 or 403', () => {",
              "  pm.expect([401, 403]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8) Negative — no token cannot list admin providers",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "url": "{{apiUrl}}/{{apiVersion}}/admin/providers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401 or 403', () => {",
              "  pm.expect([401, 403]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
