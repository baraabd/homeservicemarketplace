# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=dev
PORT=4000
LOG_LEVEL=debug

# CORS allowlist. `FRONTEND_URL` is always included. `CORS_ORIGINS` is a
# comma-separated list of ADDITIONAL origins (e.g. preview deployments).
# Production with no origins configured → all cross-origin requests blocked.
# Dev with no origins configured → reflect the request origin (local convenience).
# `credentials: true` is always on for the HttpOnly-cookie auth flow; wildcard
# is never used in production.
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL (source of truth for relational / transactional data)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/homeservicemarketplace
DATABASE_CONNECT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# MongoDB (flexible documents: portfolios, chat, dynamic metadata)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://mongo:mongo@localhost:27017/?authSource=admin
MONGODB_DB_NAME=homeservicemarketplace
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=20

# -----------------------------------------------------------------------------
# Redis (cache, locks, rate limits, queues)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Startup retry policy (infra connections)
# -----------------------------------------------------------------------------
STARTUP_MAX_RETRIES=5
STARTUP_RETRY_BASE_MS=200
STARTUP_RETRY_CAP_MS=5000

# -----------------------------------------------------------------------------
# IAM / Auth
# -----------------------------------------------------------------------------
# HS256 symmetric secret (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_a_48_byte_random_value_min_32_chars
JWT_ISSUER=hsm-api
JWT_AUDIENCE=hsm-clients
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_DAYS=30

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=15

AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
# Lower bound on response time for register / forgot-password / resend-verification.
# Closes the timing side-channel between existing-user and unknown-user paths.
# Set to 0 to disable (only for local perf debugging — never in production).
AUTH_ANTI_ENUM_DELAY_MS=200

# When true (recommended), registration issues an email OTP challenge and
# verify-otp is required before cookies are issued — this matches production
# behavior and works locally out-of-the-box because `pnpm docker:up` now
# starts Mailpit (SMTP :1025 / UI :8025). When false, registration silently
# auto-activates the user and bypasses the OTP round-trip — dev-only
# convenience; MUST be true in staging / production.
# Do not declare this key twice in `.env`; the last occurrence wins and a
# duplicate has caused silent behavior flips in the past.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Cookie settings for web clients. Choose the profile by environment:
#
#  Local dev (plain HTTP, localhost):
#    COOKIE_DOMAIN=            (empty)
#    COOKIE_SECURE=false
#    COOKIE_SAMESITE=lax
#
#  Same-site preview/prod (web + api under the same registrable domain,
#  e.g. app.example.com + api.example.com):
#    COOKIE_DOMAIN=.example.com
#    COOKIE_SECURE=true
#    COOKIE_SAMESITE=lax
#
#  Cross-site preview/prod (web on *.vercel.app, api on a different apex —
#  required for browsers to send cookies on cross-site XHR):
#    COOKIE_DOMAIN=            (empty — do not set)
#    COOKIE_SECURE=true
#    COOKIE_SAMESITE=none
#
# The refresh cookie is always SameSite=Strict regardless of this setting;
# the refresh endpoint requires a same-site POST or a Bearer X-Refresh-Token.
#
# DEFAULT BELOW IS LOCAL-DEV (HTTP). Switch to COOKIE_SECURE=true on every
# preview/staging/prod deployment — that is the production-safe setting and
# the API enforces it indirectly via FRONTEND_URL/CORS_ORIGINS configuration.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

PERMISSION_CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Realtime — Socket.IO gateway (Sprint 7.0 refined)
# -----------------------------------------------------------------------------
# When `false`, the gateway closes every WS handshake at the door and
# the polling fallback (Sprint 5.5 cadences: 15s/20s/4s) is the sole
# realtime channel. When `true`, the gateway accepts JWT-authed
# handshakes and (if a Redis client is healthy) wires
# @socket.io/redis-adapter for multi-instance fan-out. Defaults to
# `false` so existing test suites are unaffected; flip to `true` once
# Redis is provisioned in the target environment.
REALTIME_SOCKET_IO=false

# -----------------------------------------------------------------------------
# Provider take-rate (Sprint 5.6 earnings read model)
# -----------------------------------------------------------------------------
# Marketplace platform fee in basis points (1 bp = 0.01%). 1000 = 10%, 0
# = fee-free, 10000 = 100%. Applied as round(gross * BPS / 10000) per
# row + per aggregate when computing platformFees / netEarnings.
# When the payouts module ships this value moves into a per-tier rate
# table; for the read-only wallet a single env-driven rate is enough.
PROVIDER_PLATFORM_FEE_BPS=1000

# -----------------------------------------------------------------------------
# SMTP / Mail
# -----------------------------------------------------------------------------
# When SMTP_HOST is set, the API sends real emails via Nodemailer.
# When unset, the InMemoryMailAdapter is used (tests / CI).
# For local dev, `pnpm docker:up` starts Mailpit on :1025 (SMTP) and :8025
# (web UI) so the OTP/email-link flow works identically to production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@homeservicemarketplace.local

# -----------------------------------------------------------------------------
# Storage / Media uploads (Sprint 7.x)
# -----------------------------------------------------------------------------
# STORAGE_DRIVER=local (default) → LocalDiskStorageAdapter. Writes to
#   LOCAL_STORAGE_DIR (gitignored .media-uploads/ by default). The API
#   serves uploads via signed PUT + public GET routes the controller
#   exposes — no external dependency, suitable for dev / CI.
# STORAGE_DRIVER=s3                 → S3StorageAdapter. Browser PUTs go
#   directly to S3-compatible storage (AWS, R2, MinIO, DO Spaces).
#   Requires S3_BUCKET + S3_REGION at minimum.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=

# HMAC-sign upload tokens for the local adapter. Optional: when unset
# the adapter falls back to JWT_ACCESS_SECRET. Production deploys
# SHOULD set a dedicated secret so the two contexts (auth tokens vs
# media tokens) can be rotated independently.
MEDIA_SIGNING_SECRET=

# Public origin the LocalDiskStorageAdapter embeds in presigned URLs
# returned to the browser. Falls back to http://localhost:<PORT> for
# dev. In preview / prod set this to the externally-visible API origin.
PUBLIC_API_URL=

# S3-only env. None is required when STORAGE_DRIVER=local; the adapter
# throws a clear error at presign time if S3 is selected without a bucket.
# When S3_ENDPOINT is set (MinIO / R2 / DO Spaces), enable S3_FORCE_PATH_STYLE.
# Credentials default to the AWS SDK provider chain unless ID + SECRET
# are set explicitly here.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# CDN / custom domain in front of the bucket. When set, fileUrl uses this
# instead of the default https://<bucket>.s3.<region>.amazonaws.com/<key>.
S3_PUBLIC_BASE_URL=
