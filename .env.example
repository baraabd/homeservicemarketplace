# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=dev
PORT=4000
LOG_LEVEL=debug

# CORS allowlist. `FRONTEND_URL` is always included. `CORS_ORIGINS` is a
# comma-separated list of ADDITIONAL origins (e.g. preview deployments).
# Production with no origins configured → all cross-origin requests blocked.
# Dev with no origins configured → reflect the request origin (local convenience).
# `credentials: true` is always on for the HttpOnly-cookie auth flow; wildcard
# is never used in production.
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL (source of truth for relational / transactional data)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/homeservicemarketplace
DATABASE_CONNECT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# MongoDB — OPTIONAL, DISABLED BY DEFAULT. See docs/adr/0002-mongodb.md.
# -----------------------------------------------------------------------------
# A code search found no domain consumer of either Mongo model, so the only
# thing the connection fed was the readiness probe that reported on it — a
# dependency that could take a healthy API out of the load-balancer pool
# without any request ever needing it.
#
# With MONGODB_ENABLED=false (the default) the API opens no connection,
# MONGODB_URI is not required, and /health/ready does not mention Mongo.
#
# Set MONGODB_ENABLED=true to turn it back on. MONGODB_URI then becomes
# REQUIRED and the API refuses to boot without it — the misconfiguration
# surfaces at startup rather than as a readiness check going red later.
# In Docker Compose, also start the opt-in profile:
#   docker compose -f infra/docker/docker-compose.yml --profile app --profile mongo up -d
MONGODB_ENABLED=false
MONGODB_URI=mongodb://mongo:mongo@localhost:27017/?authSource=admin
MONGODB_DB_NAME=homeservicemarketplace
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=20

# -----------------------------------------------------------------------------
# Redis (cache, locks, rate limits, queues)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Startup retry policy (infra connections)
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Transactional outbox (Sprint 6) — docs/adr/0004-transactional-outbox.md
# -----------------------------------------------------------------------------
# Fan-out and other deferred work are written as OutboxEvent rows inside the
# transaction of the mutation that caused them, then delivered by a worker.
# EVERY API replica runs a worker; they coordinate through the claim statement
# (FOR UPDATE SKIP LOCKED), not through configuration, so there is nothing to
# elect and nothing to shard.
#
# Turning the worker off does not lose events — they accumulate and are
# delivered by whichever replica has it on — but a deployment with it off
# EVERYWHERE is an outage that looks like silence. Off is for tests and
# one-shot processes.
OUTBOX_WORKER_ENABLED=true
# Rows claimed per tick. A full batch re-polls immediately, so this bounds
# idle latency, not throughput.
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=2000
# How long a claimed row may sit before it is presumed orphaned by a crashed
# worker and returned to the queue. MUST exceed the slowest handler: too low
# and a healthy slow handler is reclaimed underneath itself and runs twice
# (survivable — the idempotency marker catches it — but wasted work).
OUTBOX_CLAIM_TIMEOUT_MS=120000
# Exponential backoff: base * 2^(attempts-1), capped, ±20% jitter.
# 1s, 2s, 4s, 8s, 16s, 32s, 64s, 128s across the default 8 attempts.
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_CAP_MS=300000
# PROCESSED rows are reaped after this long. DEAD rows are NEVER reaped —
# a dead letter is the only surviving evidence the event existed.
OUTBOX_RETENTION_HOURS=72
OUTBOX_CLEANUP_INTERVAL_MS=3600000
# Recipients per fan-out slice. Bounds one transaction, so a 10,000-recipient
# fan-out is 50 independently retryable batches rather than one huge write.
OUTBOX_FANOUT_BATCH_SIZE=200

# Alert on `outbox_oldest_pending_age_seconds`, not on queue depth: a large
# backlog draining quickly is healthy, a rising oldest-age never is.

STARTUP_MAX_RETRIES=5
STARTUP_RETRY_BASE_MS=200
STARTUP_RETRY_CAP_MS=5000

# -----------------------------------------------------------------------------
# IAM / Auth
# -----------------------------------------------------------------------------
# HS256 symmetric secret (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_a_48_byte_random_value_min_32_chars
JWT_ISSUER=hsm-api
JWT_AUDIENCE=hsm-clients
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_DAYS=30

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=15

AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
# Lower bound on response time for register / forgot-password / resend-verification.
# Closes the timing side-channel between existing-user and unknown-user paths.
# Set to 0 to disable (only for local perf debugging — never in production).
AUTH_ANTI_ENUM_DELAY_MS=200

# When true (recommended), registration issues an email OTP challenge and
# verify-otp is required before cookies are issued — this matches production
# behavior and works locally out-of-the-box because `pnpm docker:up` now
# starts Mailpit (SMTP :1025 / UI :8025). When false, registration silently
# auto-activates the user and bypasses the OTP round-trip — dev-only
# convenience; MUST be true in staging / production.
# Do not declare this key twice in `.env`; the last occurrence wins and a
# duplicate has caused silent behavior flips in the past.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Cookie settings for web clients. Choose the profile by environment:
#
#  Local dev (plain HTTP, localhost):
#    COOKIE_DOMAIN=            (empty)
#    COOKIE_SECURE=false
#    COOKIE_SAMESITE=lax
#
#  Same-site preview/prod (web + api under the same registrable domain,
#  e.g. app.example.com + api.example.com):
#    COOKIE_DOMAIN=.example.com
#    COOKIE_SECURE=true
#    COOKIE_SAMESITE=lax
#
#  Cross-site preview/prod (web on *.vercel.app, api on a different apex —
#  required for browsers to send cookies on cross-site XHR):
#    COOKIE_DOMAIN=            (empty — do not set)
#    COOKIE_SECURE=true
#    COOKIE_SAMESITE=none
#
# The refresh cookie is always SameSite=Strict regardless of this setting;
# the refresh endpoint requires a same-site POST or a Bearer X-Refresh-Token.
#
# DEFAULT BELOW IS LOCAL-DEV (HTTP). Switch to COOKIE_SECURE=true on every
# preview/staging/prod deployment — that is the production-safe setting and
# the API enforces it indirectly via FRONTEND_URL/CORS_ORIGINS configuration.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

PERMISSION_CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Rate limiting (D-1)
# -----------------------------------------------------------------------------
# Registration abuse budget: submissions allowed per rolling window, charged
# against BOTH the client IP and the normalised (trimmed + lowercased) email.
# PRODUCTION AND STAGING REFUSE TO BOOT with a limit above 5 or a window under
# 3600s — raise it only in development/test where suites create many accounts.
AUTH_REGISTER_THROTTLE_LIMIT=5
AUTH_REGISTER_THROTTLE_TTL_SECONDS=3600

# Rate-limit counters live in Redis so the budget is aggregate across API
# replicas rather than per-replica. When Redis is unreachable at request time
# the limiter FAILS CLOSED (429) instead of silently degrading to a bypassable
# per-instance count. Production and staging reject "false".
THROTTLE_REDIS_REQUIRED=true

# How many reverse-proxy hops sit in front of the API. Express "trust proxy" is
# set to exactly this number, so the client IP is read from the entry written
# by the hop you control and a caller cannot forge it via X-Forwarded-For.
#   0  = API is directly exposed; X-Forwarded-For is ignored entirely (default)
#   1  = one trusted LB/ingress in front (typical single-proxy deployment)
# NEVER set this higher than the number of proxies you actually operate: each
# extra hop lets a client prepend one forged address and escape its bucket.
TRUST_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# Realtime — Socket.IO gateway (Sprint 7.0 refined)
# -----------------------------------------------------------------------------
# When `false`, the gateway closes every WS handshake at the door and
# the polling fallback (Sprint 5.5 cadences: 15s/20s/4s) is the sole
# realtime channel. When `true`, the gateway accepts JWT-authed
# handshakes and (if a Redis client is healthy) wires
# @socket.io/redis-adapter for multi-instance fan-out. Defaults to
# `false` so existing test suites are unaffected; flip to `true` once
# Redis is provisioned in the target environment.
REALTIME_SOCKET_IO=false

# D-4 — cross-instance realtime security.
# Socket eviction after logout / suspension / provider-status change relies on
# Socket.IO's Redis adapter to reach sockets held by OTHER API replicas.
# Without it, a revocation served by one pod silently leaves the victim's
# socket alive on the others. When REALTIME_SOCKET_IO=on and the adapter cannot
# be wired, production and staging REFUSE TO BOOT. Set this to true only for a
# deployment you know runs exactly one API instance — it is an explicit,
# auditable acknowledgement, not a convenience toggle.
REALTIME_ALLOW_SINGLE_INSTANCE=false

# -----------------------------------------------------------------------------
# Provider take-rate (Sprint 5.6 earnings read model)
# -----------------------------------------------------------------------------
# Marketplace platform fee in basis points (1 bp = 0.01%). 1000 = 10%, 0
# = fee-free, 10000 = 100%. Applied as round(gross * BPS / 10000) per
# row + per aggregate when computing platformFees / netEarnings.
# When the payouts module ships this value moves into a per-tier rate
# table; for the read-only wallet a single env-driven rate is enough.
PROVIDER_PLATFORM_FEE_BPS=1000

# -----------------------------------------------------------------------------
# SMTP / Mail
# -----------------------------------------------------------------------------
# When SMTP_HOST is set, the API sends real emails via Nodemailer.
# When unset, the InMemoryMailAdapter is used (tests / CI).
# For local dev, `pnpm docker:up` starts Mailpit on :1025 (SMTP) and :8025
# (web UI) so the OTP/email-link flow works identically to production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@homeservicemarketplace.local

# -----------------------------------------------------------------------------
# Storage / Media uploads (Sprint 7.x)
# -----------------------------------------------------------------------------
# STORAGE_DRIVER=local (default) → LocalDiskStorageAdapter. Writes to
#   LOCAL_STORAGE_DIR (gitignored .media-uploads/ by default). The API
#   serves uploads via signed PUT + public GET routes the controller
#   exposes — no external dependency, suitable for dev / CI.
# STORAGE_DRIVER=s3                 → S3StorageAdapter. Browser PUTs go
#   directly to S3-compatible storage (AWS, R2, MinIO, DO Spaces).
#   Requires S3_BUCKET + S3_REGION at minimum.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=

# HMAC-sign upload tokens for the local adapter. Optional: when unset
# the adapter falls back to JWT_ACCESS_SECRET. Production deploys
# SHOULD set a dedicated secret so the two contexts (auth tokens vs
# media tokens) can be rotated independently.
MEDIA_SIGNING_SECRET=

# Public origin the LocalDiskStorageAdapter embeds in presigned URLs
# returned to the browser. Falls back to http://localhost:<PORT> for
# dev. In preview / prod set this to the externally-visible API origin.
PUBLIC_API_URL=

# S3-only env. None is required when STORAGE_DRIVER=local; the adapter
# throws a clear error at presign time if S3 is selected without a bucket.
# When S3_ENDPOINT is set (MinIO / R2 / DO Spaces), enable S3_FORCE_PATH_STYLE.
# Credentials default to the AWS SDK provider chain unless ID + SECRET
# are set explicitly here.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# CDN / custom domain in front of the bucket. When set, fileUrl uses this
# instead of the default https://<bucket>.s3.<region>.amazonaws.com/<key>.
S3_PUBLIC_BASE_URL=

# ── Restricted provider identity evidence (Sprint 9B / 09B.29) ────────────
#
# EVIDENCE_MAX_BYTES is REQUIRED — the API refuses to boot without it. It was
# missing from this file, so a clone that followed this example could not start
# the API at all. 10 MiB.
EVIDENCE_MAX_BYTES=10485760

# Which malware scanner clears uploaded identity evidence.
#   none    (default) no scanner. Evidence is stored and can NEVER be cleared,
#           so no provider can be verified. Safe, but the feature is off.
#   clamav  a real scanner. The only value valid in production.
#   test    a deterministic adapter for automated tests and CI. It can mark a
#           file CLEAN without scanning it, so `resolveScannerSelection` THROWS
#           at boot if a process that believes it is production asks for it.
EVIDENCE_SCANNER_DRIVER=none

# Sprint 09B.29 — the sweep that actually scans what providers upload.
#
# WHY THIS EXISTS: `EvidenceScanService.scanPending` is the only thing that
# moves evidence off PENDING, and until this sprint NOTHING in production ever
# called it. Uploads were stored and never judged, so verification-case
# submission stayed blocked on EVIDENCE_NOT_CLEAN forever and no provider could
# ever be granted work access.
#
# Default OFF, like VERIFICATION_EXPIRY_WORKER_ENABLED and for the same reason:
# the read path serves CLEAN only, and the service refuses to write CLEAN unless
# the adapter reports itself a real scanner. Off costs availability of provider
# verification, never trust.
#
# ARMING IT REQUIRES A REAL SCANNER. Setting this true with
# EVIDENCE_SCANNER_DRIVER=none produces a sweep that examines every asset and
# clears none — harmless, but it does not make the provider journey work.
EVIDENCE_SCAN_WORKER_ENABLED=false
EVIDENCE_SCAN_INTERVAL_MS=60000
EVIDENCE_SCAN_BATCH_SIZE=25

# The sibling sweep that closes lapsed verifications. Also default OFF, and
# also previously undocumented here.
VERIFICATION_EXPIRY_WORKER_ENABLED=false
VERIFICATION_EXPIRY_INTERVAL_MS=900000
VERIFICATION_EXPIRY_BATCH_SIZE=100

# Sprint 09B.29 Phase 4 — the PUBLIC media sweep.
#
# WHY THIS EXISTS: EvidenceCleanupService has deleted RESTRICTED bytes since
# Sprint 9B. Nothing did the same for public ones, so five paths produced
# objects nothing would ever remove: an abandoned avatar upload, the previous
# avatar after a replacement, the avatar after a removal, an abandoned
# portfolio upload, and a deleted portfolio image. See
# docs/provider-experience-v2/SPRINT_09B29_VERIFICATION.md section 4.3.
#
# DEFAULT OFF, AND FOR A STRONGER REASON THAN THE OTHERS. Every other
# default-off worker here is off because enabling it GRANTS something. This one
# is off because enabling it DESTROYS something. Failing safe means objects
# accumulate — the leak persists — rather than bytes disappearing that should
# not have. Turn it on deliberately, having read what it deletes.
#
# SAFE ON EVERY REPLICA. Selection is not a claim: the object delete is
# idempotent and the row write is conditional, so two replicas produce one
# deletion record. There is no leader election to configure.
PUBLIC_MEDIA_CLEANUP_WORKER_ENABLED=false
PUBLIC_MEDIA_CLEANUP_INTERVAL_MS=900000
PUBLIC_MEDIA_CLEANUP_BATCH_SIZE=50
# How long an UNFINISHED upload reservation is left alone after its presign
# expires. A reservation with no completion may be a dead upload — or a live
# one still transferring on a slow phone connection. Deleting the object out
# from under a provider watching a progress bar would be worse than the leak,
# so a full day of slack sits on top of the presign TTL.
PUBLIC_MEDIA_CLEANUP_RESERVATION_GRACE_MS=86400000

# The Sprint 9 authorization axes. Both must be ARMED for work access to be
# decided by the verification grant rather than by the legacy status column.
WORK_ACCESS_ENFORCED=false
VERIFICATION_ENFORCED=false
