# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=dev
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of allowed CORS origins (in addition to FRONTEND_URL)
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL (source of truth for relational / transactional data)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/homeservicemarketplace
DATABASE_CONNECT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# MongoDB (flexible documents: portfolios, chat, dynamic metadata)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://mongo:mongo@localhost:27017/?authSource=admin
MONGODB_DB_NAME=homeservicemarketplace
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=20

# -----------------------------------------------------------------------------
# Redis (cache, locks, rate limits, queues)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Startup retry policy (infra connections)
# -----------------------------------------------------------------------------
STARTUP_MAX_RETRIES=5
STARTUP_RETRY_BASE_MS=200
STARTUP_RETRY_CAP_MS=5000

# -----------------------------------------------------------------------------
# IAM / Auth
# -----------------------------------------------------------------------------
# HS256 symmetric secret (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_a_48_byte_random_value_min_32_chars
JWT_ISSUER=hsm-api
JWT_AUDIENCE=hsm-clients
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_DAYS=30

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=15

AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15

# Cookie settings for web clients. Set COOKIE_SECURE=false only in local dev.
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

PERMISSION_CACHE_TTL_SECONDS=60
